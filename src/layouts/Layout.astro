        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.746.953 3.71 1.455 5.704 1.456h.006c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
      </svg>
      
      <!-- Label that expands on hover -->
      <span class="max-w-0 overflow-hidden group-hover:max-w-xs transition-all duration-500 ease-out font-display font-extrabold text-[11px] sm:text-xs tracking-wider uppercase whitespace-nowrap relative z-10">
        Falar com Mãe Chinesa 💬
      </span>
    </a>
  <script>
    import { getStreak, hasReachedMilestone } from '../lib/streak-manager';

    document.addEventListener('DOMContentLoaded', () => {
      const streak = getStreak();
      const milestones = [90, 60, 30, 21, 14, 7, 3];
      for (const m of milestones) {
        if (streak.currentStreak === m && hasReachedMilestone(m)) {
          const el = document.createElement('div');
          el.innerHTML = `<div id="milestone-celebration" class="fixed inset-0 pointer-events-none z-50 flex items-center justify-center">
            <div class="text-center animate-bounce-in">
              <div class="text-6xl mb-3">🎉</div>
              <div class="bg-gray-900/90 backdrop-blur-sm rounded-2xl px-6 py-3 shadow-xl border border-amber-500/20">
                <p class="text-2xl font-bold text-amber-400">${m} dias seguidos!</p>
                <p class="text-sm text-amber-500/80 mt-1">${
                  m === 3 ? 'Já é um hábito!' :
                  m === 7 ? 'Uma semana inteira!' :
                  m === 14 ? 'Duas semanas de dedicação!' :
                  m === 21 ? '21 dias — o hábito está formado!' :
                  m === 30 ? 'Um mês de chinês!' :
                  m === 60 ? 'Dois meses impressionantes!' :
                  m === 90 ? 'Três meses — você é um guerreiro!' :
                  'Incrível!'
                }</p>
              </div>
            </div>
          </div>`;
          document.body.appendChild(el.firstElementChild);
          setTimeout(() => {
            const cel = document.getElementById('milestone-celebration');
            if (cel) {
              cel.style.transition = 'opacity 0.5s';
              cel.style.opacity = '0';
              setTimeout(() => cel.remove(), 500);
            }
          }, 2500);
          break;
        }
      }
    });
  </script>
  </body>
</html>
