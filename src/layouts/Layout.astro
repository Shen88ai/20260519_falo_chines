          </div>
        </a>

<!-- Desktop Navigation Links -->
<nav class="hidden md:flex items-center gap-8">
  <a href="/" class="text-sm font-medium text-gray-300 hover:text-brand-gold transition-colors duration-300">
    Início
  </a>
  <a href="/#nivelamento" class="text-sm font-medium text-gray-300 hover:text-brand-gold transition-colors duration-300">
    Nivelamento
  </a>
  <a href="/licoes" class="text-sm font-medium text-gray-300 hover:text-brand-gold transition-colors duration-300">
    Lições
  </a>
  <a href="/blog" class="text-sm font-medium text-gray-300 hover:text-brand-gold transition-colors duration-300">
    Blog
  </a>
  <a href="/galeria" class="text-sm font-medium text-gray-300 hover:text-brand-gold transition-colors duration-300">
    Galeria
  </a>
  <a href="/servicos-empresariais" class="text-sm font-medium text-gray-300 hover:text-brand-gold transition-colors duration-300">
    Serviços Empresariais
  </a>
  <a href="/imersao-mandarim" class="text-sm font-medium text-gray-300 hover:text-brand-gold transition-colors duration-300">
