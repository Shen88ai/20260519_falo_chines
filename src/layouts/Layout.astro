---
import '../styles/global.css';
import SearchBar from '../components/SearchBar.astro';
import StreakDisplay from '../components/StreakDisplay.astro';
import type { SearchItemData } from '../components/SearchBar.astro';

const allLessonModules = Object.entries(
  import.meta.glob('../content/lessons/**/*.md', { eager: true })
);

const allBlogModules = Object.entries(
  import.meta.glob('../content/blog/**/*.md', { eager: true })
);

function extractContent(mod: any): string {
  return typeof mod.rawContent === 'function'
    ? mod.rawContent()
    : mod.rawContent
      ? mod.rawContent
      : mod.default
        ? typeof mod.default === 'string' ? mod.default : ''
        : '';
}

const searchItems: SearchItemData[] = [
  ...allLessonModules.map(([path, mod]) => {
    const id = path.split('/src/content/lessons/').pop() ?? path;
    const slug = id.replace('.md', '').split('/').pop() ?? id;
    return {
      id,
      title: mod.frontmatter?.title ?? '',
      description: mod.frontmatter?.description ?? '',
      content: extractContent(mod),
      phase: mod.frontmatter?.phase ?? '',
      tags: mod.frontmatter?.tags ?? [],
      slug,
    };
  }),
  ...allBlogModules.map(([path, mod]) => {
    const id = path.split('/src/content/blog/').pop() ?? path;
    const slug = id.replace('.md', '') ?? id;
    return {
      id,
      title: mod.frontmatter?.title ?? '',
      description: mod.frontmatter?.description ?? '',
      content: extractContent(mod),
      phase: '',
      tags: mod.frontmatter?.tags ?? [],
      slug,
    };
  })
];

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Falo Chinês 🧭 - Sua Bússola para o Mandarim", 
  description = "Aprenda chinês de forma inteligente. Bússola Hanzi 3D, glossário integrado etimológico e análise de tom em tempo real." 
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Optimization -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    
    <!-- Fonts Preload -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
