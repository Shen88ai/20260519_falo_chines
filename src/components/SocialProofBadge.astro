---
interface Props {
  students: number;
  phase?: string;
}
const { students, phase } = Astro.props;
---

<div class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-amber-500/10 border border-amber-500/20 rounded-full text-xs text-amber-300 font-medium">
  <span>👥</span>
  <span>{students} alunos estudaram esta lição</span>
  {phase && <span class="text-amber-500/50">·</span>}
  {phase && <span class="text-amber-400">Fase {phase}</span>}
</div>
