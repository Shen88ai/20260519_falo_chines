<script>
  (function() {
    const TOTAL_VAGAS = 20;
    const today = new Date();
    const day = today.getDate();
    const daysInMonth = new Date(today.getFullYear(), today.getMonth() + 1, 0).getDate();
    const vagasUsadas = Math.min(Math.max(Math.round((day / daysInMonth) * TOTAL_VAGAS), 1), TOTAL_VAGAS);
    const vagasRestantes = TOTAL_VAGAS - vagasUsadas;
    const pct = (vagasRestantes / TOTAL_VAGAS) * 100;

    function atualizarVagas() {
      const ids = [
        { count: 'hero-vagas-count', bar: null },
        { count: 'hero-vagas-count-2', rest: 'hero-vagas-restantes-2', bar: 'hero-vagas-bar-2' },
        { count: 'cta-vagas-count', bar: null },
        { count: 'vagas-restantes', bar: 'vagas-bar', total: true },
      ];
      ids.forEach(({ count, rest, bar, total }) => {
        const el = document.getElementById(count);
        if (el) el.textContent = String(vagasRestantes);
        if (rest) {
          const r = document.getElementById(rest);
          if (r) r.textContent = String(vagasRestantes);
        }
        if (bar) {
          const b = document.getElementById(bar);
          if (b) b.style.width = pct + '%';
        }
        if (total) {
          const totalVagas = document.getElementById('vagas-total');
          if (totalVagas) totalVagas.textContent = String(TOTAL_VAGAS);
        }
      });
    }

    function track(eventName, data) {
      if (typeof gtag !== 'undefined') {
        gtag('event', eventName, { event_category: 'engagement', ...data });
      }
      if (typeof fbq !== 'undefined') {
        fbq('trackCustom', eventName, data);
      }
    }

    function trackCTA(label) {
      track('cta_click', { event_label: label, page: 'diagnostico-china' });
    }

    document.addEventListener('DOMContentLoaded', function() {
      atualizarVagas();

      // Track CTA clicks
      document.querySelectorAll('a[href*="wa.me"], a[href*="whatsapp"]').forEach(el => {
        el.addEventListener('click', function() {
          trackCTA('whatsapp_' + (this.textContent.trim().slice(0, 30)));
        });
      });
      document.querySelectorAll('a[href="#quiz"]').forEach(el => {
        el.addEventListener('click', function() {
          trackCTA('go_to_quiz');
        });
      });
      document.querySelectorAll('a[href="#precos"]').forEach(el => {
        el.addEventListener('click', function() {
          trackCTA('go_to_pricing');
        });
      });
    });
    if (document.readyState === 'complete') atualizarVagas();
  })();
</script>
