---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ToneAnalyser from '../../components/ToneAnalyser.astro';
import { dictionary } from '../../data/dictionary';
import { getZhongwenLink } from '../../lib/dictionary-utils';

// Gera caminhos estáticos para todas as lições na compilação do Astro
export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return lessons.map(lesson => {
    // Extrai o nome do arquivo plano (ex: "01-tons-primordiais") como slug de URL amigável
    const flatSlug = lesson.id.split('/').pop()?.replace('.md', '') || lesson.id;
    return {
      params: { slug: flatSlug },
      props: { lesson }
    };
  });
}

const { lesson } = Astro.props;
const { Content } = await render(lesson);

// Serializa o dicionário e utilitários para scripts do cliente
const serializedDictionary = JSON.stringify(dictionary);
---

<Layout 
  title={`${lesson.data.title} ${lesson.data.icon} - Falo Chinês`}
  description={lesson.data.description}
>
  <div class="py-10 bg-[radial-gradient(circle_at_top,rgba(251,191,36,0.02),transparent_45%)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Lesson Header (Breadcrumbs and Metadata) -->
      <div class="mb-8 border-b border-white/5 pb-6">
        <div class="flex items-center gap-2 text-xs text-gray-400 mb-3">
          <a href="/licoes" class="hover:text-brand-gold transition-colors">Lições</a>
          <span>/</span>
          <span class="text-brand-gold font-medium">{lesson.data.phaseLabel}</span>
        </div>

        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div class="flex items-start gap-4">
            <span class="text-4xl sm:text-5xl p-3 bg-white/5 rounded-2xl shadow-inner border border-white/5 self-start select-none">
              {lesson.data.icon}
            </span>
            <div>
              <h1 class="text-2xl sm:text-3xl font-display font-black text-white leading-tight">
                {lesson.data.title}
              </h1>
              <p class="text-xs sm:text-sm text-gray-400 mt-1 max-w-2xl leading-relaxed">
                {lesson.data.description}
              </p>
            </div>
          </div>
          
          <!-- Phase Indicator Badge -->
          <span class="self-start md:self-center text-[10px] font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-white/10 bg-white/5 text-gray-300">
            Fase {lesson.data.phase}
          </span>
        </div>
      </div>

      <!-- Main Layout Grid: Sidebar Map (Left) + Content (Right) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- SIDEBAR: Personal Journey Progress Minimap (cols: 3) -->
        <aside class="lg:col-span-3 space-y-6 lg:sticky lg:top-24">
          <div class="glass-panel rounded-2xl p-5 border border-white/5 shadow-xl">
            <h4 class="font-display font-extrabold text-sm text-white border-b border-white/5 pb-3 mb-4 flex items-center gap-2">
              <span>🧭</span> Rota do Aluno
            </h4>
            
            <!-- Dynamic Minimap loaded by Client State -->
            <div id="sidebar-minimap" class="space-y-3">
              <!-- Rendered Dynamically -->
              <p class="text-[11px] text-gray-500 italic">
                Faça o nivelamento na página inicial para carregar sua rota de estudos personalizada aqui.
              </p>
            </div>

            <div class="mt-6 pt-4 border-t border-white/5">
              <a 
                href="/#nivelamento" 
                class="block w-full text-center py-2 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-[10px] font-bold tracking-wider text-gray-300 uppercase transition-all duration-300"
              >
                🔄 Novo Diagnóstico
              </a>
            </div>
          </div>
        </aside>

        <!-- MAIN CONTENT: Lesson Body (cols: 9) -->
        <article class="lg:col-span-9 space-y-10">
          
          <!-- Obsidian Markdown Content -->
          <div class="glass-panel rounded-2xl p-6 sm:p-10 border border-white/5 shadow-2xl relative">
            <!-- Glowing accent border on active phase -->
            <div class={`absolute top-0 left-0 right-0 h-1.5 rounded-t-2xl bg-gradient-to-r ${
              lesson.data.phase === 'A' ? 'from-brand-red to-brand-gold' :
              lesson.data.phase === 'B' ? 'from-brand-jade to-brand-gold' :
              lesson.data.phase === 'C' ? 'from-brand-purple to-brand-gold' :
              'from-brand-blue to-brand-gold'
            }`}></div>

            <!-- Markdown Text Body -->
            <div class="prose prose-invert max-w-none text-gray-300 font-sans leading-relaxed text-sm sm:text-base space-y-6 lesson-body" id="lesson-body-el">
              <Content />
            </div>
          </div>

          <!-- INTEGRATED PITCH ANALYSER -->
          <div class="space-y-4">
            <div class="flex items-center gap-3">
              <span class="text-xl">🎙️</span>
              <h3 class="text-lg font-display font-extrabold text-white">Laboratório de Pronúncia</h3>
            </div>
            <ToneAnalyser />
          </div>

        </article>

      </div>

    </div>
  </div>

  <!-- FLOATING GLOSSARY TOOLTIP / POPUP CARD -->
  <div 
    id="glossary-popup" 
    class="fixed z-50 glass-panel rounded-2xl p-5 w-80 shadow-2xl border border-brand-gold/30 pointer-events-auto opacity-0 scale-95 translate-y-2 transition-all duration-300 bg-dark-card/95 backdrop-blur-xl hidden"
  >
    <div class="flex items-start justify-between mb-3 border-b border-white/5 pb-2">
      <div class="flex items-center gap-3">
        <span class="text-4xl font-serif-zh font-black text-white filter drop-shadow-[0_2px_4px_rgba(251,191,36,0.3)]" id="popup-char">中</span>
        <div>
          <span class="block text-sm font-display font-black text-brand-gold" id="popup-pinyin">zhōng</span>
          <span class="block text-[9px] uppercase font-bold text-gray-400 tracking-wider">Pronúncia Pinyin</span>
        </div>
      </div>
      <span class="text-[9px] font-extrabold text-gray-500 uppercase bg-white/5 px-2 py-0.5 rounded" id="popup-strokes">4 traços</span>
    </div>
    
    <div class="space-y-3 text-xs">
      <div>
        <span class="block text-[9px] uppercase font-extrabold text-gray-500 tracking-wider mb-0.5">Tradução (Português):</span>
        <p class="text-gray-200 font-bold text-sm" id="popup-portuguese">Centro / Meio / China</p>
      </div>

      <div>
        <span class="block text-[9px] uppercase font-extrabold text-gray-500 tracking-wider mb-0.5">Radical Estrutural:</span>
        <p class="text-brand-jade font-semibold" id="popup-radical">丨 (linha vertical)</p>
      </div>

      <div id="popup-mnemonica-container">
        <span class="block text-[9px] uppercase font-extrabold text-gray-500 tracking-wider mb-0.5">Dica Mnemônica:</span>
        <p class="text-gray-300 italic bg-white/5 p-2.5 rounded-lg border border-white/5 leading-relaxed" id="popup-mnemonica">
          Um retângulo atravessado...
        </p>
      </div>

      <div class="pt-3 border-t border-white/5 flex items-center justify-between">
        <span class="text-[9px] text-gray-500">Clique para abrir árvore etimológica:</span>
        <a 
          href="#" 
          target="_blank" 
          rel="noopener noreferrer" 
          id="popup-link" 
          class="text-[10px] font-extrabold text-brand-gold hover:text-brand-gold-hover hover:underline flex items-center gap-1 transition-colors"
        >
          Zhongwen.com ↗
        </a>
      </div>
    </div>
  </div>
</Layout>

<!-- Glossary Hover & Linkage Scripts -->
<script is:inline define:vars={{ serializedDictionary }}>
  (function initGlossaryAndSidebar() {
    const dict = JSON.parse(serializedDictionary);
    const body = document.getElementById('lesson-body-el');
    const popup = document.getElementById('glossary-popup');

    if (!body || !popup) return;

    // --- PARTE 1: HIGHLIGHTER E HOVER DO GLOSSÁRIO ---
    
    // Função segura para caminhar sobre os nós de texto e injetar o glossário
    function highlightTerms(element) {
      const walker = document.createTreeWalker(element, NodeFilter.SHOW_TEXT, null, false);
      const textNodes = [];
      let node;
      
      while (node = walker.nextNode()) {
        const parentTag = node.parentNode.tagName.toUpperCase();
        if (parentTag !== 'SCRIPT' && parentTag !== 'STYLE' && parentTag !== 'A' && parentTag !== 'CODE') {
          textNodes.push(node);
        }
      }

      const keys = Object.keys(dict).sort((a, b) => b.length - a.length);

      textNodes.forEach(textNode => {
        const text = textNode.nodeValue;
        let hasMatch = false;
        
        keys.forEach(key => {
          if (text.includes(key)) {
            hasMatch = true;
          }
        });

        if (hasMatch) {
          const wrapper = document.createElement('span');
          let escapedText = text
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;");

          keys.forEach(key => {
            const regex = new RegExp(key, 'g');
            const directLink = key ? `https://zhongwen.com/cgi-bin/zipfind.cgi?terms=${encodeURIComponent(key)}` : `https://zhongwen.com/`;
            
            escapedText = escapedText.replace(
              regex, 
              `<a href="${directLink}" target="_blank" rel="noopener noreferrer" class="glossary-term text-brand-gold hover:text-white border-b border-brand-gold/30 hover:border-white border-dashed font-serif-zh font-bold text-lg px-0.5 transition-colors cursor-help" data-char="${key}">${key}</a>`
            );
          });

          wrapper.innerHTML = escapedText;
          textNode.parentNode.replaceChild(wrapper, textNode);
        }
      });
    }

    highlightTerms(body);

    const popupChar = document.getElementById('popup-char');
    const popupPinyin = document.getElementById('popup-pinyin');
    const popupStrokes = document.getElementById('popup-strokes');
    const popupPortuguese = document.getElementById('popup-portuguese');
    const popupRadical = document.getElementById('popup-radical');
    const popupMnemonica = document.getElementById('popup-mnemonica');
    const popupMnemonicaContainer = document.getElementById('popup-mnemonica-container');
    const popupLink = document.getElementById('popup-link');

    let activeTimeout = null;

    body.querySelectorAll('.glossary-term').forEach(term => {
      term.addEventListener('mouseenter', (e) => {
        if (activeTimeout) clearTimeout(activeTimeout);

        const char = term.dataset.char;
        const entry = dict[char];
        if (!entry) return;

        if (popupChar) popupChar.textContent = entry.character;
        if (popupPinyin) popupPinyin.textContent = entry.pinyin;
        if (popupStrokes) popupStrokes.textContent = `${entry.strokeCount} traços`;
        if (popupPortuguese) popupPortuguese.textContent = entry.portuguese;
        if (popupRadical) popupRadical.textContent = entry.radical;
        
        if (entry.mnemonica) {
          if (popupMnemonica) popupMnemonica.textContent = entry.mnemonica;
          if (popupMnemonicaContainer) popupMnemonicaContainer.classList.remove('hidden');
        } else {
          if (popupMnemonicaContainer) popupMnemonicaContainer.classList.add('hidden');
        }

        if (popupLink) {
          popupLink.href = char ? `https://zhongwen.com/cgi-bin/zipfind.cgi?terms=${encodeURIComponent(char)}` : `https://zhongwen.com/`;
        }

        popup.classList.remove('hidden');
        setTimeout(() => {
          popup.classList.remove('opacity-0', 'scale-95', 'translate-y-2');
        }, 10);

        const rect = term.getBoundingClientRect();
        const popupRect = popup.getBoundingClientRect();
        
        let left = rect.left + window.scrollX + (rect.width / 2) - (popupRect.width / 2);
        left = Math.max(10, Math.min(window.innerWidth - popupRect.width - 10, left));

        let top = rect.top + window.scrollY - popupRect.height - 12;
        if (rect.top < popupRect.height + 40) {
          top = rect.bottom + window.scrollY + 12;
        }

        popup.style.left = `${left}px`;
        popup.style.top = `${top}px`;
      });

      term.addEventListener('mouseleave', () => {
        activeTimeout = setTimeout(() => {
          fadePopupOut();
        }, 300);
      });
    });

    popup.addEventListener('mouseenter', () => {
      if (activeTimeout) clearTimeout(activeTimeout);
    });

    popup.addEventListener('mouseleave', () => {
      activeTimeout = setTimeout(() => {
        fadePopupOut();
      }, 300);
    });

    function fadePopupOut() {
      popup.classList.add('opacity-0', 'scale-95', 'translate-y-2');
      setTimeout(() => {
        if (popup.classList.contains('opacity-0')) {
          popup.classList.add('hidden');
        }
      }, 300);
    }

    // --- PARTE 2: CARREGAMENTO DO MINIMAP DA JORNADA ---
    const sidebarMinimap = document.getElementById('sidebar-minimap');
    if (!sidebarMinimap) return;

    try {
      const journey = JSON.parse(localStorage.getItem('falo-chines-journey') || 'null');
      
      if (journey && journey.path) {
        const pathRoutes = {
          A: [
            { slug: '01-tons-primordiais', title: 'Tons Primordiais' },
            { slug: '02-pinyin-iniciais', title: 'Iniciais & Finais' },
            { slug: '03-radicais-fundamentais', title: 'Radicais Hanzi' },
            { slug: '04-sintaxe-basica', title: 'Sintaxe Básica' },
            { slug: '05-hsk-negocios', title: 'HSK & Negócios' },
            { slug: '06-mae-chinesa-fluencia', title: 'Método Mãe Chinesa' },
            { slug: '07-crianca-interior-fluencia', title: 'Criança de 5 Anos' }
          ],
          B: [
            { slug: '01-tons-primordiais', title: 'Tons Primordiais' },
            { slug: '02-pinyin-iniciais', title: 'Iniciais & Finais' },
            { slug: '04-sintaxe-basica', title: 'Sintaxe Básica' },
            { slug: '06-mae-chinesa-fluencia', title: 'Método Mãe Chinesa' },
            { slug: '07-crianca-interior-fluencia', title: 'Criança de 5 Anos' }
          ],
          C: [
            { slug: '01-tons-primordiais', title: 'Tons Primordiais' },
            { slug: '02-pinyin-iniciais', title: 'Iniciais & Finais' },
            { slug: '03-radicais-fundamentais', title: 'Radicais Hanzi' },
            { slug: '04-sintaxe-basica', title: 'Sintaxe Básica' },
            { slug: '06-mae-chinesa-fluencia', title: 'Método Mãe Chinesa' },
            { slug: '07-crianca-interior-fluencia', title: 'Criança de 5 Anos' }
          ],
          D: [
            { slug: '01-tons-primordiais', title: 'Tons Primordiais' },
            { slug: '03-radicais-fundamentais', title: 'Radicais Hanzi' },
            { slug: '04-sintaxe-basica', title: 'Sintaxe Básica' },
            { slug: '06-mae-chinesa-fluencia', title: 'Método Mãe Chinesa' },
            { slug: '07-crianca-interior-fluencia', title: 'Criança de 5 Anos' }
          ]
        };

        const currentPathInfo = {
          A: '👔 Rota do Executivo',
          B: '✈️ Rota do Viajante',
          C: '🎓 Rota do Acadêmico',
          D: '🎭 Rota do Entusiasta'
        };

        const currentSlug = window.location.pathname.split('/').pop() || '';
        const checkpoints = pathRoutes[journey.path] || [];
        const pathName = currentPathInfo[journey.path] || 'Sua Jornada';

        let checkpointHtml = `
          <div class="text-[10px] font-bold uppercase tracking-wider text-brand-gold bg-brand-gold/10 px-3 py-1.5 rounded-lg border border-brand-gold/20 mb-3 text-center">
            ${pathName}
          </div>
          <div class="relative pl-4 space-y-4 border-l border-white/10 ml-2 mt-2">
        `;

        checkpoints.forEach((cp, i) => {
          const isCurrent = cp.slug === currentSlug;
          const currentIdx = checkpoints.findIndex(x => x.slug === currentSlug);
          const isCompleted = currentIdx !== -1 && i < currentIdx;

          const dotColorClass = isCurrent 
            ? 'bg-brand-gold ring-4 ring-brand-gold/20 border-white' 
            : (isCompleted ? 'bg-brand-jade border-brand-jade' : 'bg-dark-card border-white/20');
            
          const titleColorClass = isCurrent 
            ? 'text-white font-extrabold' 
            : (isCompleted ? 'text-gray-400 line-through' : 'text-gray-400');

          checkpointHtml += `
            <div class="relative flex items-center gap-3">
              <!-- Point Timeline Marker -->
              <span class="absolute -left-[21px] w-3 h-3 rounded-full border-2 ${dotColorClass} transition-all duration-300"></span>
              
              <!-- Checkpoint Link -->
              <a href="/licoes/${cp.slug}" class="text-xs transition-colors hover:text-brand-gold ${titleColorClass}">
                ${cp.title} ${isCompleted ? '✓' : ''}
              </a>
            </div>
          `;
        });

        checkpointHtml += `</div>`;
        sidebarMinimap.innerHTML = checkpointHtml;
      }
    } catch (e) {
      console.warn("Falha ao desenhar minimap da jornada:", e);
    }
  })();
</script>
