---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ToneAnalyser from '../../components/ToneAnalyser.astro';
import SocialProofBadge from '../../components/SocialProofBadge.astro';
import { dictionary } from '../../data/dictionary';
import { socialProof } from '../../data/social-proof-data';
import { getZhongwenLink } from '../../lib/dictionary-utils';
import ComunidadeCard from '../../components/ComunidadeCard.astro';
import comunidadeData from '../../data/comunidade-data.json';

// Build lesson lookup for client-side teaser generation
const allLessons = await getCollection('lessons');
const lessonLookup: Record<string, { title: string; characters: string[]; phaseLabel: string; tags: string[]; description: string }> = {};
for (const l of allLessons) {
  const slug = l.id.split('/').pop()?.replace('.md', '') || l.id;
  lessonLookup[slug] = {
    title: l.data.title,
    characters: l.data.characters ?? [],
    phaseLabel: l.data.phaseLabel,
    tags: l.data.tags ?? [],
    description: l.data.description,
  };
}

// Gera caminhos estáticos para todas as lições na compilação do Astro
export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return lessons.map(lesson => {
    // Extrai o nome do arquivo plano (ex: "01-tons-primordiais") como slug de URL amigável
    const flatSlug = lesson.id.split('/').pop()?.replace('.md', '') || lesson.id;
    return {
      params: { slug: flatSlug },
      props: { lesson }
    };
  });
}

const { lesson } = Astro.props;
const { Content } = await render(lesson);

const flatSlug = lesson.id.split('/').pop()?.replace('.md', '') || lesson.id;

// Serializa o dicionário e utilitários para scripts do cliente
const serializedDictionary = JSON.stringify(dictionary);
const serializedLessonLookup = JSON.stringify(lessonLookup);

// Ordered lesson list for prev/next navigation
const allLessonSlugs = (await getCollection('lessons'))
  .filter(l => (l.id.split('/').pop()?.replace('.md', '') || l.id) !== '01-about')
  .sort((a, b) => (a.data.order || 99) - (b.data.order || 99))
  .map(l => ({
    slug: l.id.split('/').pop()?.replace('.md', '') || l.id,
    title: l.data.title,
    icon: l.data.icon,
  }));
const currentIdx = allLessonSlugs.findIndex(l => l.slug === flatSlug);
const prevLesson = currentIdx > 0 ? allLessonSlugs[currentIdx - 1] : null;
const nextLesson = currentIdx < allLessonSlugs.length - 1 ? allLessonSlugs[currentIdx + 1] : null;


// Related situações for this lesson
const relatedSituacoes = (comunidadeData.situacoes || [])
  .filter(s => s.lessonSlug === flatSlug)
  .sort((a, b) => b.votes - a.votes);

// Related comments for this lesson
const relatedComments = (comunidadeData.comentarios || [])
  .filter(c => c.lessonSlug === flatSlug && c.approved !== false)
  .sort((a, b) => b.timestamp - a.timestamp);
---

<Layout 
  title={`${lesson.data.title} ${lesson.data.icon} - Falo Chinês`}
  description={lesson.data.description}
>
  <div class="py-10 bg-[radial-gradient(circle_at_top,rgba(251,191,36,0.02),transparent_45%)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Cover Image -->
      {lesson.data.coverImage && (
        <div class="mb-8 -mx-4 sm:-mx-6 lg:-mx-8">
          <img 
            src={lesson.data.coverImage} 
            alt="" 
            class="w-full aspect-[21/9] object-cover rounded-xl sm:rounded-2xl bg-dark-surface shadow-xl"
            loading="eager"
          />
        </div>
      )}

      <!-- Lesson Header (Breadcrumbs and Metadata) -->
      <div class="mb-8 border-b border-white/5 pb-6">
        <div class="flex items-center gap-2 text-xs text-gray-400 mb-3">
          <a href="/licoes" class="hover:text-brand-gold transition-colors">Lições</a>
          <span>/</span>
          <span class="text-brand-gold font-medium">{lesson.data.phaseLabel}</span>
        </div>
        <div class="mb-4">
          <SocialProofBadge
            students={socialProof.lessons[flatSlug]?.students ?? 0}
            phase={lesson.data.phase}
          />
        </div>

        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div class="flex items-start gap-4">
            <span class="text-4xl sm:text-5xl p-3 bg-white/5 rounded-2xl shadow-inner border border-white/5 self-start select-none">
              {lesson.data.icon}
            </span>
            <div>
              <h1 class="text-2xl sm:text-3xl font-display font-black text-white leading-tight">
                {lesson.data.title}
              </h1>
              <p class="text-xs sm:text-sm text-gray-400 mt-1 max-w-2xl leading-relaxed">
                {lesson.data.description}
              </p>
            </div>
          </div>
          
          <!-- Phase Indicator Badge -->
          <span class="self-start md:self-center text-[10px] font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-white/10 bg-white/5 text-gray-300">
            Fase {lesson.data.phase}
          </span>
        </div>
      </div>

      <!-- Main Layout Grid: Sidebar Map (Left) + Content (Right) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- SIDEBAR: Personal Journey Progress Minimap (cols: 3) -->
        <aside class="lg:col-span-3 space-y-6 lg:sticky lg:top-24">
          <div class="glass-panel rounded-2xl p-5 border border-white/5 shadow-xl">
            <h4 class="font-display font-extrabold text-sm text-white border-b border-white/5 pb-3 mb-4 flex items-center gap-2">
              <span>🧭</span> Rota do Aluno
            </h4>
            
            <!-- Dynamic Minimap loaded by Client State -->
            <div id="sidebar-minimap" class="space-y-3">
              <!-- Rendered Dynamically -->
              <p class="text-[11px] text-gray-500 italic">
                Faça o nivelamento na página inicial para carregar sua rota de estudos personalizada aqui.
              </p>
            </div>

            <div class="mt-6 pt-4 border-t border-white/5">
              <a 
                href="/#nivelamento" 
                class="block w-full text-center py-2 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-[10px] font-bold tracking-wider text-gray-300 uppercase transition-all duration-300"
              >
                🔄 Novo Diagnóstico
              </a>
            </div>
          </div>
        </aside>

        <!-- MAIN CONTENT: Lesson Body (cols: 9) -->
        <article class="lg:col-span-9 space-y-10">
          
          <!-- Markdown Content -->
          <div class="glass-panel rounded-2xl p-6 sm:p-10 border border-white/5 shadow-2xl relative">
            <!-- Glowing accent border on active phase -->
            <div class={`absolute top-0 left-0 right-0 h-1.5 rounded-t-2xl bg-gradient-to-r ${
              lesson.data.phase === 'A' ? 'from-brand-red to-brand-gold' :
              lesson.data.phase === 'B' ? 'from-brand-jade to-brand-gold' :
              lesson.data.phase === 'C' ? 'from-brand-purple to-brand-gold' :
              'from-brand-blue to-brand-gold'
            }`}></div>

            <!-- Markdown Text Body -->
            <div class="prose prose-invert max-w-none text-gray-300 font-sans leading-relaxed text-sm sm:text-base space-y-6 lesson-body" id="lesson-body-el">
              <Content />
            </div>
          </div>

          <!-- INTEGRATED PITCH ANALYSER -->
          <div class="space-y-4">
            <div class="flex items-center gap-3">
              <span class="text-xl">🎙️</span>
              <h3 class="text-lg font-display font-extrabold text-white">Laboratório de Pronúncia</h3>
            </div>
            <ToneAnalyser />
          </div>

          <!-- PREV / NEXT LESSON NAVIGATION -->
          {(prevLesson || nextLesson) && (
            <div class="flex items-stretch justify-between gap-4 pt-2">
              {prevLesson ? (
                <a
                  href={`/licoes/${prevLesson.slug}`}
                  class="flex-1 flex items-center gap-3 glass-panel rounded-xl px-5 py-4 border border-white/5 hover:border-brand-gold/30 transition-all duration-300 group"
                >
                  <span class="text-2xl shrink-0">{prevLesson.icon}</span>
                  <div class="text-left min-w-0">
                    <span class="block text-[9px] uppercase font-bold text-gray-500 tracking-wider">← Anterior</span>
                    <span class="block text-sm font-bold text-white group-hover:text-brand-gold transition-colors truncate">{prevLesson.title}</span>
                  </div>
                </a>
              ) : (
                <div class="flex-1" />
              )}

              {nextLesson ? (
                <a
                  href={`/licoes/${nextLesson.slug}`}
                  class="flex-1 flex items-center gap-3 glass-panel rounded-xl px-5 py-4 border border-white/5 hover:border-brand-gold/30 transition-all duration-300 group justify-end text-right"
                >
                  <div class="text-right min-w-0">
                    <span class="block text-[9px] uppercase font-bold text-gray-500 tracking-wider">Próxima →</span>
                    <span class="block text-sm font-bold text-white group-hover:text-brand-gold transition-colors truncate">{nextLesson.title}</span>
                  </div>
                  <span class="text-2xl shrink-0">{nextLesson.icon}</span>
                </a>
              ) : (
                <div class="flex-1" />
              )}
            </div>
          )}

          <!-- SUA VEZ: Community Engagement CTAs -->
          <div class="glass-panel rounded-2xl p-6 sm:p-8 border border-white/5 shadow-2xl">
            <div class="flex items-center gap-3 mb-5">
              <span class="text-xl">🤝</span>
              <h3 class="text-lg font-display font-extrabold text-white">Sua Vez!</h3>
              <span class="text-[10px] text-gray-500 font-medium">Contribua com a comunidade</span>
            </div>

            <div class="flex flex-col sm:flex-row gap-4">
              <ComunidadeCard
                icon="🗣️"
                title="Peça uma Situação"
                description="Tem uma situação do dia a dia que você não sabe como expressar em chinês?"
                href="/comunidade#situacoes"
                cta="Pedir"
              />
              <ComunidadeCard
                icon="🔍"
                title="Registre Dificuldade"
                description="Algum caractere desta lição te travou? Marque aqui para ajudar outros alunos."
                href="/comunidade#dificuldades"
                cta="Registrar"
              />
              <ComunidadeCard
                icon="🧠"
                title="Compartilhe um Macete"
                description="Tem um jeito criativo de memorizar um caractere? Compartilhe com a turma!"
                href="/comunidade#macetes"
                cta="Enviar"
              />
            </div>

            <div class="mt-5 pt-4 border-t border-white/5 text-center">
              <a
                href="/comunidade"
                class="inline-flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wider text-brand-gold hover:text-white transition-colors"
              >
                📊 Ver comunidade completa →
              </a>
            </div>
          </div>

          {relatedSituacoes.length > 0 && (
          <div class="glass-panel rounded-2xl p-6 sm:p-8 border border-white/5 shadow-2xl">
            <div class="flex items-center gap-3 mb-5">
              <span class="text-xl">🗣️</span>
              <h3 class="text-lg font-display font-extrabold text-white">Situações Relacionadas</h3>
              <span class="text-[10px] text-gray-500 font-medium">{relatedSituacoes.length} {relatedSituacoes.length === 1 ? 'sugestão' : 'sugestões'}</span>
            </div>
            <div class="space-y-3">
              {relatedSituacoes.map(s => (
                <div class="rounded-xl p-4 border border-white/5 bg-white/[0.02]">
                  <h4 class="text-sm font-display font-bold text-white">{s.title}</h4>
                  <p class="text-[11px] text-gray-400 mt-1">{s.description}</p>
                  <div class="flex items-center gap-2 mt-2 flex-wrap">
                    {(s.tags || []).map(t => <span class="text-[9px] px-2 py-0.5 rounded-full bg-white/5 text-gray-400 border border-white/5">{t}</span>)}
                    <span class="text-[10px] text-gray-500">👍 {s.votes}</span>
                  </div>
                </div>
              ))}
            </div>
            <div class="mt-4 pt-3 border-t border-white/5 text-center">
              <a href="/comunidade#situacoes" class="text-[11px] font-bold uppercase tracking-wider text-brand-gold hover:text-white transition-colors">➕ Sugerir nova situação para esta lição</a>
            </div>
          </div>
          )}

          <!-- Comments Section -->
          <div class="glass-panel rounded-2xl p-6 sm:p-8 border border-white/5 shadow-2xl">
            <div class="flex items-center gap-3 mb-6">
              <span class="text-xl">💬</span>
              <h3 class="text-lg font-display font-extrabold text-white">Comentários</h3>
              <span class="text-[10px] text-gray-500 font-medium">{relatedComments.length} {relatedComments.length === 1 ? 'comentário' : 'comentários'}</span>
            </div>

            {relatedComments.length > 0 && (
            <div class="space-y-4 mb-8">
              {relatedComments.map(c => (
                <div class="flex items-start gap-3 p-4 rounded-xl bg-white/[0.02] border border-white/5">
                  <div class="w-8 h-8 rounded-full bg-brand-gold/20 text-brand-gold flex items-center justify-center text-sm font-bold shrink-0">
                    {c.author.charAt(0).toUpperCase()}
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 mb-0.5">
                      <span class="text-xs font-bold text-white">{c.author}</span>
                      <span class="text-[9px] text-gray-500">{new Date(c.timestamp).toLocaleDateString('pt-BR')}</span>
                    </div>
                    <p class="text-sm text-gray-300">“{c.text}”</p>
                  </div>
                </div>
              ))}
            </div>
            )}

            {relatedComments.length === 0 && (
            <p class="text-gray-500 text-sm text-center py-8 border border-dashed border-white/5 rounded-xl mb-8">
              Nenhum comentário ainda. Seja o primeiro!
            </p>
            )}

            <!-- Quick Comment Form (localStorage) -->
            <div class="border-t border-white/5 pt-6">
              <p class="text-xs text-gray-400 mb-3">Deixe seu comentário sobre esta lição:</p>
              <input id="lesson-comment-author" type="text" placeholder="Seu nome" class="w-full mb-2 px-4 py-2 rounded-xl bg-white/5 border border-white/10 text-white text-sm placeholder-gray-500 focus:outline-none focus:border-brand-gold/50 transition-colors" />
              <textarea id="lesson-comment-text" rows="3" placeholder="Escreva seu comentário..." class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white text-sm placeholder-gray-500 focus:outline-none focus:border-brand-gold/50 transition-colors resize-none"></textarea>
              <div class="flex items-center justify-between mt-3">
                <button id="lesson-comment-submit" class="text-xs font-bold uppercase tracking-wider px-4 py-2 rounded-xl bg-brand-gold/20 text-brand-gold hover:bg-brand-gold/30 border border-brand-gold/30 transition-all">Enviar</button>
              </div>
              <p id="lesson-comment-feedback" class="text-[11px] text-brand-jade mt-2 hidden">✓ Comentário salvo! Aparecerá após moderação.</p>
            </div>
          </div>

        </article>

      </div>

    </div>
  </div>

  <!-- FLOATING GLOSSARY TOOLTIP / POPUP CARD -->
  <div 
    id="glossary-popup" 
    class="fixed z-50 glass-panel rounded-2xl p-5 w-80 shadow-2xl border border-brand-gold/30 pointer-events-auto opacity-0 scale-95 translate-y-2 transition-all duration-300 bg-dark-card/95 backdrop-blur-xl hidden"
  >
    <div class="flex items-start justify-between mb-3 border-b border-white/5 pb-2">
      <div class="flex items-center gap-3">
        <span class="text-4xl font-zh font-black text-white filter drop-shadow-[0_2px_4px_rgba(251,191,36,0.3)]" id="popup-char">中</span>
        <div>
          <span class="block text-sm font-display font-black text-brand-gold" id="popup-pinyin">zhōng</span>
          <span class="block text-[9px] uppercase font-bold text-gray-400 tracking-wider">Pronúncia Pinyin</span>
          <div id="popup-traditional-container" class="hidden mt-1">
            <span class="block text-[9px] uppercase font-bold text-brand-gold/70 tracking-wider">Tradicional:</span>
            <span class="block text-lg font-zh font-bold text-white" id="popup-traditional"></span>
          </div>
        </div>
      </div>
      <span class="text-[9px] font-extrabold text-gray-500 uppercase bg-white/5 px-2 py-0.5 rounded" id="popup-strokes">4 traços</span>
    </div>
    
    <div class="space-y-3 text-xs">
      <div>
        <span class="block text-[9px] uppercase font-extrabold text-gray-500 tracking-wider mb-0.5">Tradução (Português):</span>
        <p class="text-gray-200 font-bold text-sm" id="popup-portuguese">Centro / Meio / China</p>
      </div>

      <div>
        <span class="block text-[9px] uppercase font-extrabold text-gray-500 tracking-wider mb-0.5">Radical Estrutural:</span>
        <p class="text-brand-jade font-semibold" id="popup-radical">丨 (linha vertical)</p>
      </div>

      <div id="popup-mnemonica-container">
        <span class="block text-[9px] uppercase font-extrabold text-gray-500 tracking-wider mb-0.5">Dica Mnemônica:</span>
        <p class="text-gray-300 italic bg-white/5 p-2.5 rounded-lg border border-white/5 leading-relaxed" id="popup-mnemonica">
          Um retângulo atravessado...
        </p>
      </div>

      <div class="pt-3 border-t border-white/5 flex items-center justify-between">
        <span class="text-[9px] text-gray-500">Clique para abrir árvore etimológica:</span>
        <a 
          href="#" 
          target="_blank" 
          rel="noopener noreferrer" 
          id="popup-link" 
          class="text-[10px] font-extrabold text-brand-gold hover:text-brand-gold-hover hover:underline flex items-center gap-1 transition-colors"
        >
          Zhongwen.com ↗
        </a>
      </div>
      <div class="pt-3 border-t border-white/5 mt-3">
        <button id="popup-difficulty-btn" class="text-[10px] font-bold text-gray-400 hover:text-brand-gold transition-colors flex items-center gap-1">
          😓 Tive dificuldade com este caractere
        </button>
        <div id="popup-difficulty-options" class="hidden mt-2 space-y-1">
          <p class="text-[9px] uppercase font-bold text-gray-500 tracking-wider mb-1">Qual tipo?</p>
          <div class="flex flex-wrap gap-1.5" id="popup-difficulty-types">
            <button class="diff-btn text-[10px] px-2.5 py-1 rounded-lg bg-white/5 hover:bg-white/10 text-gray-300 border border-white/5 transition-colors" data-type="tone">Tom / Pronúncia</button>
            <button class="diff-btn text-[10px] px-2.5 py-1 rounded-lg bg-white/5 hover:bg-white/10 text-gray-300 border border-white/5 transition-colors" data-type="strokes">Ordem dos traços</button>
            <button class="diff-btn text-[10px] px-2.5 py-1 rounded-lg bg-white/5 hover:bg-white/10 text-gray-300 border border-white/5 transition-colors" data-type="meaning">Significado</button>
            <button class="diff-btn text-[10px] px-2.5 py-1 rounded-lg bg-white/5 hover:bg-white/10 text-gray-300 border border-white/5 transition-colors" data-type="radical">Memorizar radical</button>
            <button class="diff-btn text-[10px] px-2.5 py-1 rounded-lg bg-white/5 hover:bg-white/10 text-gray-300 border border-white/5 transition-colors" data-type="other">Outro</button>
          </div>
          <p id="popup-difficulty-feedback" class="text-[10px] text-brand-jade hidden mt-1">✓ Registrado!</p>
        </div>
        <span id="popup-difficulty-heat" class="text-[10px] text-gray-500 hidden mt-1 block"></span>
      </div>
    </div>
  </div>
</Layout>

<!-- Glossary Hover & Linkage Scripts -->
<script is:inline define:vars={{ serializedDictionary, serializedLessonLookup, flatSlug }}>
  // Comunidade storage for inline use
  var comunidadeStorage = (function() {
    function read(k) { try { return JSON.parse(localStorage.getItem(k) || '[]') } catch(e) { return [] } }
    function write(k, d) { localStorage.setItem(k, JSON.stringify(d)) }
    function uid() { return Date.now().toString(36) + Math.random().toString(36).slice(2, 8) }
    return {
      addDifficulty: function(c, t, ls) { var list = read('falo-chines-difficulties'); list.push({ character: c, type: t, lessonSlug: ls, timestamp: Date.now() }); write('falo-chines-difficulties', list); },
      getDifficulties: function() { return read('falo-chines-difficulties') },
      addMnemonic: function(c, text, author) { var list = read('falo-chines-mnemonics'); list.push({ id: uid(), character: c, text: text, author: author, votes: 0, timestamp: Date.now() }); write('falo-chines-mnemonics', list); return list[list.length - 1]; },
      getMnemonics: function() { return read('falo-chines-mnemonics') },
      getMnemonicsByChar: function(c) { return read('falo-chines-mnemonics').filter(function(m) { return m.character === c }) },
      voteMnemonic: function(id) { var list = read('falo-chines-mnemonics'); var idx = list.findIndex(function(m) { return m.id === id }); if (idx === -1) return null; list[idx].votes++; write('falo-chines-mnemonics', list); return list[idx]; },
      addSituation: function(title, desc, tags, lessonSlug) { var list = read('falo-chines-situations'); var s = { id: uid(), title: title, description: desc, tags: tags, votes: 1, status: 'pendente', author: 'Anônimo', lessonSlug: lessonSlug || '', timestamp: Date.now() }; list.push(s); write('falo-chines-situations', list); return s; },
    };
  })();
  var __currentChar = '';
  window.__currentLessonSlug = flatSlug;

  // Simplified→Traditional map for popup display
  var simplifiedToTraditional = {
    '国':'國','学':'學','妈':'媽','马':'馬','语':'語','书':'書','师':'師','爱':'愛','乐':'樂',
    '旧':'舊','临':'臨','刘':'劉','斋':'齋','园':'園','图':'圖','孙':'孫','尘':'塵','头':'頭',
    '个':'個','从':'從','们':'們','体':'體','战':'戰','戏':'戲','吗':'嗎','时':'時','云':'雲',
    '灯':'燈','烧':'燒','烟':'煙','岁':'歲','岛':'島','银':'銀','铁':'鐵','铜':'銅','针':'針',
    '说':'說','话':'話','请':'請','谢':'謝','带':'帶','药':'藥','丰':'豐','觅':'覓','业':'業',
    '东':'東','长':'長','门':'門','风':'風','见':'見','贝':'貝','车':'車','万':'萬','龙':'龍','骂':'罵','儿':'兒'
  };
  function getCharDisplay(char) {
    var t = simplifiedToTraditional[char];
    return t ? char + ' (' + t + ')' : char;
  }
  function getTraditional(char) {
    return simplifiedToTraditional[char] || '';
  }

  (function initGlossaryAndSidebar() {
    const dict = JSON.parse(serializedDictionary);
    const lessonLookup = JSON.parse(serializedLessonLookup);
    const body = document.getElementById('lesson-body-el');
    const popup = document.getElementById('glossary-popup');

    if (!body || !popup) return;

    // --- PARTE 1: HIGHLIGHTER E HOVER DO GLOSSÁRIO ---
    
    // Função segura para caminhar sobre os nós de texto e injetar o glossário
    function highlightTerms(element) {
      const walker = document.createTreeWalker(element, NodeFilter.SHOW_TEXT, null, false);
      const textNodes = [];
      let node;
      
      while (node = walker.nextNode()) {
        const parentTag = node.parentNode.tagName.toUpperCase();
        if (parentTag !== 'SCRIPT' && parentTag !== 'STYLE' && parentTag !== 'A' && parentTag !== 'CODE') {
          textNodes.push(node);
        }
      }

      const keys = Object.keys(dict).sort((a, b) => b.length - a.length);

      textNodes.forEach(textNode => {
        const text = textNode.nodeValue;
        let hasMatch = false;
        
        keys.forEach(key => {
          if (text.includes(key)) {
            hasMatch = true;
          }
        });

        if (hasMatch) {
          const wrapper = document.createElement('span');
          let escapedText = text
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;");

          keys.forEach(key => {
            const regex = new RegExp(key, 'g');
            const directLink = key ? `https://zdic.net/hans/${encodeURIComponent(key)}` : `https://zdic.net/`;
            
            escapedText = escapedText.replace(
              regex, 
              `<a href="${directLink}" target="_blank" rel="noopener noreferrer" class="glossary-term text-brand-gold hover:text-white border-b border-brand-gold/30 hover:border-white border-dashed font-zh font-bold text-lg px-0.5 transition-colors cursor-help" data-char="${key}">${key}</a>`
            );
          });

          wrapper.innerHTML = escapedText;
          textNode.parentNode.replaceChild(wrapper, textNode);
        }
      });
    }

    highlightTerms(body);

    const popupChar = document.getElementById('popup-char');
    const popupPinyin = document.getElementById('popup-pinyin');
    const popupStrokes = document.getElementById('popup-strokes');
    const popupPortuguese = document.getElementById('popup-portuguese');
    const popupRadical = document.getElementById('popup-radical');
    const popupMnemonica = document.getElementById('popup-mnemonica');
    const popupMnemonicaContainer = document.getElementById('popup-mnemonica-container');
    const popupLink = document.getElementById('popup-link');

    let activeTimeout = null;

    body.querySelectorAll('.glossary-term').forEach(term => {
      term.addEventListener('mouseenter', (e) => {
        if (activeTimeout) clearTimeout(activeTimeout);

        const char = term.dataset.char;
        const entry = dict[char];
        if (!entry) return;

        __currentChar = char;
        resetDifficultyUI();

        if (popupChar) popupChar.textContent = getCharDisplay(entry.character);
        if (popupPinyin) popupPinyin.textContent = entry.pinyin;
        if (popupStrokes) popupStrokes.textContent = `${entry.strokeCount} traços`;
        if (popupPortuguese) popupPortuguese.textContent = entry.portuguese;
        if (popupRadical) popupRadical.textContent = entry.radical;

        var popupTraditional = document.getElementById('popup-traditional');
        var popupTraditionalContainer = document.getElementById('popup-traditional-container');
        var trad = getTraditional(entry.character);
        if (trad && popupTraditional && popupTraditionalContainer) {
          popupTraditional.textContent = trad;
          popupTraditionalContainer.classList.remove('hidden');
        } else if (popupTraditionalContainer) {
          popupTraditionalContainer.classList.add('hidden');
        }
        
        if (entry.mnemonica) {
          if (popupMnemonica) popupMnemonica.textContent = entry.mnemonica;
          if (popupMnemonicaContainer) popupMnemonicaContainer.classList.remove('hidden');
        } else {
          if (popupMnemonicaContainer) popupMnemonicaContainer.classList.add('hidden');
        }

          if (popupLink) {
            popupLink.href = char ? `https://zdic.net/hans/${encodeURIComponent(char)}` : `https://zdic.net/`;
          }

        popup.classList.remove('hidden');
        setTimeout(() => {
          popup.classList.remove('opacity-0', 'scale-95', 'translate-y-2');
        }, 10);

        const rect = term.getBoundingClientRect();
        const popupRect = popup.getBoundingClientRect();
        
        let left = rect.left + window.scrollX + (rect.width / 2) - (popupRect.width / 2);
        left = Math.max(10, Math.min(window.innerWidth - popupRect.width - 10, left));

        let top = rect.top + window.scrollY - popupRect.height - 12;
        if (rect.top < popupRect.height + 40) {
          top = rect.bottom + window.scrollY + 12;
        }

        popup.style.left = `${left}px`;
        popup.style.top = `${top}px`;
      });

      term.addEventListener('mouseleave', () => {
        activeTimeout = setTimeout(() => {
          fadePopupOut();
        }, 300);
      });
    });

    popup.addEventListener('mouseenter', () => {
      if (activeTimeout) clearTimeout(activeTimeout);
    });

    popup.addEventListener('mouseleave', () => {
      activeTimeout = setTimeout(() => {
        fadePopupOut();
      }, 300);
    });

    function fadePopupOut() {
      popup.classList.add('opacity-0', 'scale-95', 'translate-y-2');
      setTimeout(() => {
        if (popup.classList.contains('opacity-0')) {
          popup.classList.add('hidden');
        }
      }, 300);
    }

    // --- Difficulty tracking ---
    var difficultyBtn = document.getElementById('popup-difficulty-btn');
    var difficultyOptions = document.getElementById('popup-difficulty-options');
    var difficultyFeedback = document.getElementById('popup-difficulty-feedback');
    var difficultyHeat = document.getElementById('popup-difficulty-heat');

    function resetDifficultyUI() {
      if (difficultyOptions) difficultyOptions.classList.add('hidden');
      if (difficultyFeedback) difficultyFeedback.classList.add('hidden');
    }

    if (difficultyBtn) {
      difficultyBtn.addEventListener('click', function() {
        if (difficultyOptions) difficultyOptions.classList.toggle('hidden');
      });
    }

    document.querySelectorAll('#popup-difficulty-types .diff-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var type = this.getAttribute('data-type');
        if (!__currentChar) return;
        try {
          comunidadeStorage.addDifficulty(__currentChar, type, window.__currentLessonSlug || '');
          if (difficultyOptions) difficultyOptions.classList.add('hidden');
          if (difficultyFeedback) {
            difficultyFeedback.classList.remove('hidden');
            setTimeout(function() { difficultyFeedback.classList.add('hidden'); }, 2000);
          }
          var all = comunidadeStorage.getDifficulties();
          var count = all.filter(function(d) { return d.character === __currentChar; }).length;
          if (difficultyHeat && count > 1) {
            difficultyHeat.textContent = '\uD83D\uDD25 ' + count + ' alunos registraram dificuldade';
            difficultyHeat.classList.remove('hidden');
          }
        } catch(e) { console.warn('Falha ao salvar dificuldade:', e); }
      });
    });

    // --- PARTE 2: CARREGAMENTO DO MINIMAP DA JORNADA ---
    const sidebarMinimap = document.getElementById('sidebar-minimap');
    if (!sidebarMinimap) return;

    try {
      const journey = JSON.parse(localStorage.getItem('falo-chines-journey') || 'null');
      
      if (journey && journey.path) {
        const pathRoutes = {
          A: [
            { slug: '01-tons-primordiais', title: 'Tons Primordiais' },
            { slug: '02-pinyin-iniciais', title: 'Iniciais & Finais' },
            { slug: '03-radicais-fundamentais', title: 'Radicais Hanzi' },
            { slug: '04-sintaxe-basica', title: 'Sintaxe Básica' },
            { slug: '05-hsk-negocios', title: 'HSK & Negócios' },
            { slug: '06-mae-chinesa-fluencia', title: 'Método Mãe Chinesa' },
            { slug: '07-crianca-interior-fluencia', title: 'Criança de 5 Anos' }
          ],
          B: [
            { slug: '01-tons-primordiais', title: 'Tons Primordiais' },
            { slug: '02-pinyin-iniciais', title: 'Iniciais & Finais' },
            { slug: '04-sintaxe-basica', title: 'Sintaxe Básica' },
            { slug: '06-mae-chinesa-fluencia', title: 'Método Mãe Chinesa' },
            { slug: '07-crianca-interior-fluencia', title: 'Criança de 5 Anos' }
          ],
          C: [
            { slug: '01-tons-primordiais', title: 'Tons Primordiais' },
            { slug: '02-pinyin-iniciais', title: 'Iniciais & Finais' },
            { slug: '03-radicais-fundamentais', title: 'Radicais Hanzi' },
            { slug: '04-sintaxe-basica', title: 'Sintaxe Básica' },
            { slug: '06-mae-chinesa-fluencia', title: 'Método Mãe Chinesa' },
            { slug: '07-crianca-interior-fluencia', title: 'Criança de 5 Anos' }
          ],
          D: [
            { slug: '01-tons-primordiais', title: 'Tons Primordiais' },
            { slug: '03-radicais-fundamentais', title: 'Radicais Hanzi' },
            { slug: '04-sintaxe-basica', title: 'Sintaxe Básica' },
            { slug: '06-mae-chinesa-fluencia', title: 'Método Mãe Chinesa' },
            { slug: '07-crianca-interior-fluencia', title: 'Criança de 5 Anos' }
          ]
        };

        const currentPathInfo = {
          A: '👔 Rota do Executivo',
          B: '✈️ Rota do Viajante',
          C: '🎓 Rota do Acadêmico',
          D: '🎭 Rota do Entusiasta'
        };

        // Inline teaser generator for client-side use
        function generateTeaser(slug) {
          const lesson = lessonLookup[slug];
          if (!lesson) return '🔒 Próxima lição';
          const templates = [];
          if (lesson.characters && lesson.characters.length > 0) {
            const c = lesson.characters[Math.floor(Math.random() * lesson.characters.length)];
            templates.push(`🔒 O segredo do caractere ${c}`);
          }
          if (lesson.tags && lesson.tags.length > 0) {
            const tag = lesson.tags[Math.floor(Math.random() * lesson.tags.length)];
            templates.push(`🔒 Domine os ${tag} como um nativo`);
          }
          const topic = (lesson.phaseLabel || '').split(' & ')[0];
          if (topic) templates.push(`🔒 O erro que todo brasileiro comete em ${topic.toLowerCase()}`);
          templates.push(`🔒 Próxima parada: ${(lesson.title || '').split(':')[0]}`);
          return templates[Math.floor(Math.random() * templates.length)];
        }

        const currentSlug = window.location.pathname.split('/').pop() || '';
        const checkpoints = pathRoutes[journey.path] || [];
        const pathName = currentPathInfo[journey.path] || 'Sua Jornada';
        const currentIdx = checkpoints.findIndex(x => x.slug === currentSlug);
        const completedCount = currentIdx > 0 ? currentIdx : 0;
        const remainingCount = checkpoints.length - currentIdx - 1;

        let checkpointHtml = `
          <div class="text-[10px] font-bold uppercase tracking-wider text-brand-gold bg-brand-gold/10 px-3 py-1.5 rounded-lg border border-brand-gold/20 mb-3 text-center">
            ${pathName}
          </div>
          <div class="relative pl-4 border-l border-white/10 ml-2 mt-2">
        `;

        // Past checkpoints: collapsed into summary
        if (completedCount > 0) {
          checkpointHtml += `
            <div class="relative pb-2">
              <span class="absolute -left-[21px] top-1 w-3 h-3 rounded-full border-2 bg-brand-jade border-brand-jade"></span>
              <button id="toggle-past-checkpoints" class="text-xs text-gray-500 hover:text-brand-gold transition-colors flex items-center gap-1">
                <span>✓ ${completedCount} ${completedCount === 1 ? 'concluída' : 'concluídas'}</span>
                <span id="toggle-past-arrow" class="text-[10px]">▶</span>
              </button>
              <div id="past-checkpoints" class="hidden mt-2 space-y-2 pl-2 border-l border-white/5 ml-2">
          `;
          for (let i = 0; i < currentIdx; i++) {
            const cp = checkpoints[i];
            checkpointHtml += `
              <div class="relative flex items-center gap-2">
                <span class="absolute -left-[17px] w-2 h-2 rounded-full bg-brand-jade/60"></span>
                <a href="/licoes/${cp.slug}" class="text-[11px] text-gray-500 hover:text-brand-gold transition-colors line-through">
                  ${cp.title} ✓
                </a>
              </div>
            `;
          }
          checkpointHtml += `</div></div>`;
        }

        // Current checkpoint
        const currentCp = checkpoints[currentIdx];
        if (currentCp) {
          checkpointHtml += `
            <div class="relative flex items-center gap-3 py-3">
              <span class="absolute -left-[21px] w-3 h-3 rounded-full border-2 bg-brand-gold ring-4 ring-brand-gold/20 border-white"></span>
              <span class="text-xs text-white font-extrabold">${currentCp.title}</span>
              <span class="text-[9px] text-brand-gold font-bold uppercase">● Agora</span>
            </div>
          `;
        }

        // Next checkpoint: locked with teaser (only if not on the last one)
        const nextIdx = currentIdx >= 0 ? currentIdx + 1 : 0;
        if (nextIdx < checkpoints.length) {
          const nextCp = checkpoints[nextIdx];
          const teaser = generateTeaser(nextCp.slug);
          checkpointHtml += `
            <div class="relative flex items-center gap-3 py-3 opacity-60">
              <span class="absolute -left-[21px] w-3 h-3 rounded-full border-2 bg-dark-card border-white/20"></span>
              <a href="/licoes/${nextCp.slug}" class="text-xs text-gray-400 hover:text-brand-gold transition-colors">
                ${teaser}
              </a>
            </div>
          `;
        }

        // Remaining count hint
        if (remainingCount > 1) {
          checkpointHtml += `
            <div class="relative flex items-center gap-3 py-2">
              <span class="absolute -left-[21px] w-3 h-3 rounded-full border-2 border-dashed border-white/10"></span>
              <span class="text-[10px] text-gray-500">+${remainingCount} ${remainingCount === 1 ? 'passo' : 'passos'} pela frente</span>
            </div>
          `;
        }

        checkpointHtml += `</div>`;
        sidebarMinimap.innerHTML = checkpointHtml;

        // Toggle past checkpoints
        const toggleBtn = document.getElementById('toggle-past-checkpoints');
        const pastList = document.getElementById('past-checkpoints');
        const toggleArrow = document.getElementById('toggle-past-arrow');
        if (toggleBtn && pastList) {
          toggleBtn.addEventListener('click', () => {
            const isHidden = pastList.classList.contains('hidden');
            pastList.classList.toggle('hidden');
            if (toggleArrow) toggleArrow.textContent = isHidden ? '▼' : '▶';
          });
        }
      }
    } catch (e) {
      console.warn("Falha ao desenhar minimap da jornada:", e);
    }
  })();

  // Lesson page quick comment (localStorage)
  document.getElementById('lesson-comment-submit')?.addEventListener('click', function() {
    const author = document.getElementById('lesson-comment-author').value.trim() || 'Anônimo';
    const text = document.getElementById('lesson-comment-text').value.trim();
    if (!text) return;
    try {
      const list = JSON.parse(localStorage.getItem('falo-chines-comments') || '[]');
      list.push({
        id: Date.now().toString(36) + Math.random().toString(36).slice(2, 8),
        postSlug: '',
        lessonSlug: window.__currentLessonSlug || flatSlug,
        author: author,
        text: text,
        approved: false,
        timestamp: Date.now()
      });
      localStorage.setItem('falo-chines-comments', JSON.stringify(list));
      document.getElementById('lesson-comment-text').value = '';
      document.getElementById('lesson-comment-feedback').classList.remove('hidden');
      setTimeout(function() { document.getElementById('lesson-comment-feedback').classList.add('hidden'); }, 3000);
    } catch(e) { console.warn('Falha ao salvar comentário:', e); }
  });
</script>
