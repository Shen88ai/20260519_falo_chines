---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

// Busca todas as lições do cofre Obsidian na build
const allLessons = await getCollection('lessons');

const getSlug = (id: string) => id.split('/').pop()?.replace('.md', '') || id;

// Ordena as lições por fase e depois pela ordem numérica
const sortedLessons = allLessons.sort((a, b) => {
  if (a.data.phase !== b.data.phase) {
    return a.data.phase.localeCompare(b.data.phase);
  }
  return a.data.order - b.data.order;
});

// Agrupa as lições por fase para exibição estruturada
const phases = {
  A: {
    title: 'Fase A: Fonética & Tons (Pinyin)',
    desc: 'Construa a base melódica. Aprenda a pronunciar as sílabas e dominar os 4 tons cruciais.',
    color: 'border-brand-red text-brand-red bg-brand-red/5',
    lessons: sortedLessons.filter(l => l.data.phase === 'A')
  },
  B: {
    title: 'Fase B: Ideogramas & Radicais (Hanzi)',
    desc: 'Desvende a lógica visual dos caracteres chineses desmontando-os em blocos lógicos.',
    color: 'border-brand-jade text-brand-jade bg-brand-jade/5',
    lessons: sortedLessons.filter(l => l.data.phase === 'B')
  },
  C: {
    title: 'Fase C: Sintaxe & Diálogo (Gramática)',
    desc: 'Una os blocos. Construa frases lógicas e aprenda estruturas conversacionais úteis.',
    color: 'border-brand-purple text-brand-purple bg-brand-purple/5',
    lessons: sortedLessons.filter(l => l.data.phase === 'C')
  },
  D: {
    title: 'Fase D: HSK & Negócios (Imersão)',
    desc: 'Pronto para o mercado. Estude a etiqueta comercial e prepare-se para os exames oficiais HSK.',
    color: 'border-brand-blue text-brand-blue bg-brand-blue/5',
    lessons: sortedLessons.filter(l => l.data.phase === 'D')
  }
};
---

<Layout title="Cofre de Lições Obsidian 📚 - Falo Chinês" description="Navegue pelas lições criadas e organizadas diretamente do Obsidian Vault para o seu navegador.">
  <div class="py-12 bg-[radial-gradient(circle_at_top,rgba(251,191,36,0.02),transparent_40%)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Page Header -->
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="text-xs font-bold text-brand-gold uppercase tracking-widest bg-brand-gold/10 px-3 py-1.5 rounded-full border border-brand-gold/20">
          Cofre de Aprendizado 📚
        </span>
        <h1 class="text-3xl sm:text-4xl font-display font-black text-white mt-4">
          Lições do Obsidian Vault
        </h1>
        <p class="text-xs sm:text-sm text-gray-400 mt-2">
          Nossas matérias são escritas em Markdown e estruturadas em fases pedagógicas lógicas, garantindo um aprendizado sequencial escalável.
        </p>
      </div>

      <!-- Phase Sections -->
      <div class="space-y-16">
        {Object.entries(phases).map(([key, phase]) => (
          <div class="space-y-6" id={key}>
            <!-- Phase Header Badge -->
            <div class={`p-4 rounded-2xl border ${phase.color} backdrop-blur-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4`}>
              <div>
                <h2 class="font-display font-black text-lg sm:text-xl text-white">
                  {phase.title}
                </h2>
                <p class="text-xs text-gray-300 mt-1">
                  {phase.desc}
                </p>
              </div>
              <span class="text-xs font-extrabold uppercase tracking-widest px-3 py-1 bg-black/35 rounded-full self-start sm:self-center">
                {phase.lessons.length} {phase.lessons.length === 1 ? 'Lição' : 'Lições'}
              </span>
            </div>

            <!-- Lessons Grid -->
            {phase.lessons.length === 0 ? (
              <div class="glass-panel rounded-2xl p-8 text-center text-xs text-gray-500 border border-dashed border-white/5">
                Nenhuma lição adicionada nesta fase ainda. Adicione novos arquivos .md na pasta `src/content/lessons/` pelo Obsidian para vê-los aqui!
              </div>
            ) : (
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {phase.lessons.map(lesson => (
                  <a 
                    href={`/licoes/${getSlug(lesson.id)}`} 
                    class="group glass-panel rounded-2xl p-5 border border-white/5 hover:border-brand-gold/25 transition-all duration-300 flex flex-col justify-between hover:-translate-y-1 shadow-md"
                  >
                    <div>
                      <!-- Card Header -->
                      <div class="flex items-center justify-between mb-4">
                        <span class="text-3xl p-2 bg-white/5 rounded-xl group-hover:scale-110 transition-transform">
                          {lesson.data.icon}
                        </span>
                        {lesson.data.featured && (
                          <span class="text-[9px] font-bold uppercase tracking-wider text-brand-gold bg-brand-gold/10 px-2.5 py-0.5 rounded-full border border-brand-gold/20">
                            Destaque ⭐
                          </span>
                        )}
                      </div>

                      <!-- Card Title & Desc -->
                      <h3 class="font-display font-bold text-base text-white group-hover:text-brand-gold transition-colors line-clamp-1">
                        {lesson.data.title}
                      </h3>
                      <p class="text-xs text-gray-400 mt-2 leading-relaxed line-clamp-2">
                        {lesson.data.description}
                      </p>
                    </div>

                    <!-- Card Footer: Tags -->
                    <div class="mt-6 pt-4 border-t border-white/5 flex flex-wrap gap-1.5">
                      {lesson.data.tags.slice(0, 3).map(tag => (
                        <span class="text-[9px] text-gray-400 bg-white/5 px-2 py-0.5 rounded">
                          #{tag}
                        </span>
                      ))}
                    </div>
                  </a>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>

    </div>
  </div>
</Layout>
