---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import comunidadeData from '../../data/comunidade-data.json';


export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => {
    const slug = post.id.replace('.md', '') || post.id;
    return {
      params: { slug },
      props: { post }
    };
  });
}

const { post } = Astro.props;
const { Content } = await render(post);

const flatSlug = post.id.replace('.md', '') || post.id;
const relatedComments = (comunidadeData.comentarios || [])
  .filter(c => c.postSlug === flatSlug && c.approved !== false)
  .sort((a, b) => b.timestamp - a.timestamp);
---

<Layout 
  title={`${post.data.title} 🖊️ - Falo Chinês`}
  description={post.data.description}
>
  <div class="py-10 bg-[radial-gradient(circle_at_top,rgba(251,191,36,0.02),transparent_45%)]">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumbs -->
      <div class="mb-6">
        <a href="/blog" class="text-xs text-gray-400 hover:text-brand-gold transition-colors">
          ← Voltar para o Blog
        </a>
      </div>

      <!-- Cover Image -->
      {post.data.coverImage && (
        <div class="mb-8 -mx-4 sm:-mx-6 lg:-mx-8">
          <img 
            src={post.data.coverImage} 
            alt="" 
            class="w-full aspect-[21/9] object-cover rounded-xl sm:rounded-2xl bg-dark-surface shadow-xl"
            loading="eager"
          />
        </div>
      )}

      <!-- Post Header -->
      <header class="mb-10 border-b border-white/5 pb-8">
        <div class="flex items-center gap-2 text-xs text-gray-500 mb-3">
          <time datetime={post.data.date}>
            {new Date(post.data.date).toLocaleDateString('pt-BR', { day: 'numeric', month: 'long', year: 'numeric' })}
          </time>
          {post.data.readingTime && (
            <>
              <span>·</span>
              <span>{post.data.readingTime} min de leitura</span>
            </>
          )}
        </div>

        <h1 class="text-2xl sm:text-3xl font-display font-black text-white leading-tight">
          {post.data.title}
        </h1>
        <p class="text-sm text-gray-400 mt-3 leading-relaxed">
          {post.data.description}
        </p>

        <div class="flex items-center gap-3 mt-4">
          <span class="text-xs text-gray-500">Por {post.data.author}</span>
          {post.data.tags.length > 0 && (
            <div class="flex flex-wrap gap-1.5">
              {post.data.tags.map(tag => (
                <span class="text-[9px] text-gray-400 bg-white/5 px-2 py-0.5 rounded">
                  #{tag}
                </span>
              ))}
            </div>
          )}
        </div>
      </header>

      <!-- Post Content -->
      <article class="glass-panel rounded-2xl p-6 sm:p-10 border border-white/5 shadow-2xl relative">
        <div class="absolute top-0 left-0 right-0 h-1.5 rounded-t-2xl bg-gradient-to-r from-brand-gold to-brand-red"></div>
        <div class="prose prose-invert max-w-none text-gray-300 font-sans leading-relaxed text-sm sm:text-base space-y-6">
          <Content />
        </div>
      </article>

      <!-- Comments Section -->
      <div class="mt-12 glass-panel rounded-2xl p-6 sm:p-8 border border-white/5 shadow-2xl">
        <div class="flex items-center gap-3 mb-6">
          <span class="text-xl">💬</span>
          <h3 class="text-lg font-display font-extrabold text-white">Comentários</h3>
          <span class="text-[10px] text-gray-500 font-medium">{relatedComments.length} {relatedComments.length === 1 ? 'comentário' : 'comentários'}</span>
        </div>

        {relatedComments.length > 0 && (
        <div class="space-y-4 mb-8">
          {relatedComments.map(c => (
            <div class="flex items-start gap-3 p-4 rounded-xl bg-white/[0.02] border border-white/5">
              <div class="w-8 h-8 rounded-full bg-brand-gold/20 text-brand-gold flex items-center justify-center text-sm font-bold shrink-0">
                {c.author.charAt(0).toUpperCase()}
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-0.5">
                  <span class="text-xs font-bold text-white">{c.author}</span>
                  <span class="text-[9px] text-gray-500">{new Date(c.timestamp).toLocaleDateString('pt-BR')}</span>
                </div>
                <p class="text-sm text-gray-300">“{c.text}”</p>
              </div>
            </div>
          ))}
        </div>
        )}

        {relatedComments.length === 0 && (
        <p class="text-gray-500 text-sm text-center py-8 border border-dashed border-white/5 rounded-xl mb-8">
          Nenhum comentário ainda. Seja o primeiro!
        </p>
        )}

        <!-- Quick Comment Form (localStorage) -->
        <div class="border-t border-white/5 pt-6" id="blog-comment-form">
          <p class="text-xs text-gray-400 mb-3">Deixe seu comentário:</p>
          <input id="blog-comment-author" type="text" placeholder="Seu nome" class="w-full mb-2 px-4 py-2 rounded-xl bg-white/5 border border-white/10 text-white text-sm placeholder-gray-500 focus:outline-none focus:border-brand-gold/50 transition-colors" />
          <textarea id="blog-comment-text" rows="3" placeholder="Escreva seu comentário..." class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white text-sm placeholder-gray-500 focus:outline-none focus:border-brand-gold/50 transition-colors resize-none"></textarea>
          <div class="flex items-center justify-between mt-3">
            <button id="blog-comment-submit" class="text-xs font-bold uppercase tracking-wider px-4 py-2 rounded-xl bg-brand-gold/20 text-brand-gold hover:bg-brand-gold/30 border border-brand-gold/30 transition-all">Enviar</button>
          </div>
          <p id="blog-comment-feedback" class="text-[11px] text-brand-jade mt-2 hidden">✓ Comentário salvo! Aparecerá após moderação.</p>
        </div>
      </div>

      <!-- Footer Navigation -->
      <div class="mt-10 text-center">
        <a 
          href="/blog" 
          class="inline-flex items-center gap-2 text-xs font-bold text-gray-400 hover:text-brand-gold transition-colors"
        >
          ← Ver todos os posts
        </a>
      </div>

    </div>
  </div>
</Layout>

<script is:inline define:vars={{ flatSlug }}>
  document.getElementById('blog-comment-submit')?.addEventListener('click', function() {
    const author = document.getElementById('blog-comment-author').value.trim() || 'Anônimo';
    const text = document.getElementById('blog-comment-text').value.trim();
    if (!text) return;
    try {
      const list = JSON.parse(localStorage.getItem('falo-chines-comments') || '[]');
      list.push({
        id: Date.now().toString(36) + Math.random().toString(36).slice(2, 8),
        postSlug: flatSlug,
        lessonSlug: '',
        author: author,
        text: text,
        approved: false,
        timestamp: Date.now()
      });
      localStorage.setItem('falo-chines-comments', JSON.stringify(list));
      document.getElementById('blog-comment-text').value = '';
      document.getElementById('blog-comment-feedback').classList.remove('hidden');
      setTimeout(function() { document.getElementById('blog-comment-feedback').classList.add('hidden'); }, 3000);
    } catch(e) { console.warn('Falha ao salvar comentário:', e); }
  });
</script>
