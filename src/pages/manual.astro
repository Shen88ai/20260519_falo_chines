---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Manual de Caligrafia Chinesa 📜 - Domine os Traços do Zero" 
  description="Domine a caligrafia chinesa: aprenda a ordem dos traços, os significados e a beleza dos caracteres com o método Shen Ai de Shen Yung Ying. Adquira seu manual na Hotmart."
>
  <!-- Background Decorative Ink/Glow Elements -->
  <div class="absolute top-24 left-1/4 w-96 h-96 bg-brand-red/10 rounded-full blur-[120px] pointer-events-none -z-10"></div>
  <div class="absolute top-[800px] right-1/4 w-[450px] h-[450px] bg-brand-gold/5 rounded-full blur-[150px] pointer-events-none -z-10"></div>

  <!-- HERO SECTION -->
  <section class="relative py-20 lg:py-28 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-8 items-center">
        
        <!-- Left Side: Direct Response Copy -->
        <div class="lg:col-span-7 space-y-8 text-left">
          
          <!-- Trust Badge / Hook -->
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-gold/10 border border-brand-gold/25 text-brand-gold text-xs font-semibold tracking-wide uppercase">
            <span>✨ Método Shen Ai</span>
            <span class="w-1.5 h-1.5 rounded-full bg-brand-gold"></span>
            <span>Escrita de Nível Mestre</span>
          </div>

          <!-- Headline -->
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-black text-white leading-[1.1] tracking-tight">
            Quem disse que escrever em chinês é impossível? <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-gold to-yellow-200">Descubra o método</span> que já ensinou milhares de pessoas a dar os primeiros traços.
          </h1>

          <!-- Subheadline -->
          <p class="text-lg sm:text-xl text-gray-300 leading-relaxed max-w-2xl font-sans">
            Com mais de 45 mil visualizações comprovando a simplicidade do método no YouTube, a professora Shen Yung Ying preparou o guia definitivo para você dominar a ordem dos traços, a disciplina visual e os significados da escrita sem complicação.
          </p>

          <!-- CTAs and Badges -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2">
            <button 
              id="cta-hero"
              class="px-8 py-5 text-center text-sm font-bold bg-gradient-to-r from-brand-gold to-amber-400 text-dark-bg rounded-xl shadow-[0_4px_25px_rgba(251,191,36,0.35)] hover:shadow-[0_4px_30px_rgba(251,191,36,0.5)] hover:-translate-y-0.5 active:translate-y-0 transition-all duration-300 tracking-wider uppercase font-display cursor-pointer"
            >
              GARANTIR MEU MANUAL COM DESCONTO
            </button>
            
            <div class="flex items-center justify-center gap-2 text-xs text-gray-400">
              <span class="text-brand-jade text-lg">🛡️</span>
              <div class="text-left">
                <p class="font-semibold text-gray-200">Compra 100% Segura</p>
                <p>Garantia de 7 dias via Hotmart</p>
              </div>
            </div>
          </div>

          <!-- Social Proof Summary -->
          <div class="flex items-center gap-4 pt-4 border-t border-white/5 max-w-md">
            <div class="flex -space-x-3">
              <span class="w-9 h-9 rounded-full bg-brand-red flex items-center justify-center text-sm border-2 border-dark-bg">💮</span>
              <span class="w-9 h-9 rounded-full bg-brand-gold flex items-center justify-center text-sm border-2 border-dark-bg">✍️</span>
              <span class="w-9 h-9 rounded-full bg-brand-jade flex items-center justify-center text-sm border-2 border-dark-bg">🧭</span>
            </div>
            <p class="text-xs sm:text-sm text-gray-400 font-sans">
              <strong class="text-white">+45 mil pessoas</strong> já assistiram e aprovaram a didática simplificada.
            </p>
          </div>

        </div>

        <!-- Right Side: Ebook Cover representation -->
        <div class="lg:col-span-5 flex justify-center items-center">
          <div class="relative group">
            <!-- Glow behind book -->
            <div class="absolute -inset-2 bg-gradient-to-tr from-brand-red to-brand-gold rounded-3xl blur-2xl opacity-30 group-hover:opacity-45 transition duration-500"></div>
            
            <!-- Ebook Cover container -->
            <div class="relative max-w-[320px] sm:max-w-[360px] aspect-[3/4] bg-dark-card rounded-2xl border border-white/10 shadow-[0_20px_50px_rgba(0,0,0,0.5)] overflow-hidden transition-transform duration-500 group-hover:scale-[1.02] group-hover:rotate-1">
              <img 
                src="/ebook/capa_ebook_numero.png" 
                alt="Capa do Manual de Caligrafia Chinesa - Falo Chinês" 
                class="w-full h-full object-cover"
                loading="eager"
              />
            </div>

            <!-- Floating Badge -->
            <div class="absolute -bottom-6 -right-6 bg-dark-surface border border-white/10 p-4 rounded-2xl shadow-xl flex items-center gap-3 animate-bounce-slow">
              <span class="text-3xl">📘</span>
              <div class="text-left">
                <p class="text-[10px] text-brand-gold font-bold tracking-widest uppercase">Formato PDF</p>
                <p class="text-xs font-bold text-white">Leitura em Qualquer Dispositivo</p>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- AUTHOR AUTHORITY & INTERCULTURAL JOURNEY -->
  <section class="py-20 bg-black/30 border-y border-white/5 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-xs font-bold text-brand-gold tracking-widest uppercase mb-3 font-display">A Jornada por trás do Método</h2>
        <p class="text-3xl sm:text-4xl font-display font-black text-white">Quem é Shen Yung Ying?</p>
        <p class="mt-4 text-gray-400 font-sans">
          Uma ponte viva entre a sabedoria do Oriente e a praticidade do Ocidente.
        </p>
      </div>

      <div class="grid lg:grid-cols-12 gap-12 items-center">
        <!-- Text Bio -->
        <div class="lg:col-span-7 space-y-6 text-left">
          <h3 class="text-2xl font-display font-bold text-white">
            Especialista em Comunicação Intercultural
          </h3>
          <p class="text-gray-300 font-sans leading-relaxed">
            Com mais de 15 anos de experiência no mercado asiático como tradutora e intérprete, Shen Yung Ying viveu na pele o choque cultural e a barreira da comunicação. Foi essa vivência que a impulsionou a criar o <strong>Método Shen Ai</strong>: uma metodologia que traduz a complexidade da escrita tradicional para uma estrutura lógica, lógica e natural para ocidentais.
          </p>
          <p class="text-gray-300 font-sans leading-relaxed">
            Seu percurso de vida não é apenas geográfico, mas cultural. Cada mudança moldou sua visão sobre como ensinar um idioma complexo de forma afetiva, intuitiva e sem mistificações.
          </p>

          <!-- Timeline Map Path -->
          <div class="pt-6">
            <h4 class="text-xs font-bold text-brand-gold tracking-widest uppercase mb-4">Linha do tempo intercultural:</h4>
            
            <div class="relative pl-6 border-l-2 border-brand-red/30 space-y-6">
              
              <!-- Taiwan -->
              <div class="relative">
                <span class="absolute -left-[31px] top-0.5 w-4 h-4 rounded-full bg-brand-red border-4 border-dark-bg"></span>
                <p class="text-sm font-bold text-white">Taiwan</p>
                <p class="text-xs text-gray-400">Origem, onde a caligrafia milenar corre nas veias desde a infância.</p>
              </div>

              <!-- Paraguai -->
              <div class="relative">
                <span class="absolute -left-[31px] top-0.5 w-4 h-4 rounded-full bg-brand-gold border-4 border-dark-bg"></span>
                <p class="text-sm font-bold text-white">Paraguai</p>
                <p class="text-xs text-gray-400">Primeiro contato e adaptação aos costumes e línguas sul-americanas.</p>
              </div>

              <!-- Chile -->
              <div class="relative">
                <span class="absolute -left-[31px] top-0.5 w-4 h-4 rounded-full bg-brand-jade border-4 border-dark-bg"></span>
                <p class="text-sm font-bold text-white">Chile</p>
                <p class="text-xs text-gray-400">Consolidação acadêmica e atuação internacional em tradução.</p>
              </div>

              <!-- Brasil -->
              <div class="relative">
                <span class="absolute -left-[31px] top-0.5 w-4 h-4 rounded-full bg-brand-blue border-4 border-dark-bg"></span>
                <p class="text-sm font-bold text-white">Brasil</p>
                <p class="text-xs text-gray-400">Residência atual. Foco em aproximar estudantes brasileiros da fluência e cultura chinesa.</p>
              </div>

            </div>
          </div>
        </div>

        <!-- Decorative Map Mockup -->
        <div class="lg:col-span-5 flex justify-center">
          <div class="glass-panel border border-white/5 rounded-3xl p-8 w-full max-w-[400px] text-center space-y-6 relative overflow-hidden">
            <div class="absolute -top-12 -right-12 w-36 h-36 bg-brand-red/10 rounded-full blur-xl pointer-events-none"></div>
            
            <span class="text-6xl block">🗺️</span>
            
            <div class="space-y-2">
              <span class="px-2.5 py-1 rounded bg-brand-jade/10 text-brand-jade text-[10px] font-bold uppercase tracking-wider">Ponte Oriente-Ocidente</span>
              <h4 class="font-display font-bold text-white text-lg">Conexão Multilingue</h4>
              <p class="text-xs text-gray-400 font-sans px-4">
                "A caligrafia chinesa não é apenas desenho. É a materialização de ideias e sentimentos. Aprender a escrever é aprender a ver o mundo de outra forma."
              </p>
            </div>
            
            <div class="pt-4 border-t border-white/5 flex justify-around text-center">
              <div>
                <p class="text-lg font-bold text-brand-gold">15+</p>
                <p class="text-[9px] text-gray-400 uppercase tracking-wider">Anos de Exp.</p>
              </div>
              <div class="border-l border-white/5"></div>
              <div>
                <p class="text-lg font-bold text-brand-red">4</p>
                <p class="text-[9px] text-gray-400 uppercase tracking-wider">Países Vividos</p>
              </div>
              <div class="border-l border-white/5"></div>
              <div>
                <p class="text-lg font-bold text-brand-jade">100%</p>
                <p class="text-[9px] text-gray-400 uppercase tracking-wider">Prático</p>
              </div>
            </div>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- SOCIAL PROOF & YOUTUBE INTEGRATION -->
  <section class="py-20 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-xs font-bold text-brand-gold tracking-widest uppercase mb-3 font-display">Prova de que Funciona</h2>
        <h3 class="text-3xl sm:text-4xl font-display font-black text-white">Veja a Didática na Prática</h3>
        <p class="mt-4 text-gray-400 font-sans">
          Mais de 45 mil visualizações provam: quem vê o método funcionando no YouTube percebe que escrever em chinês não é um bicho de sete cabeças.
        </p>
      </div>

      <!-- Embedded Video Frame -->
      <div class="max-w-4xl mx-auto mb-12">
        <div class="relative aspect-video w-full rounded-2xl overflow-hidden border border-brand-gold/30 shadow-[0_0_40px_rgba(251,191,36,0.15)] bg-black">
          <iframe 
            class="absolute inset-0 w-full h-full" 
            src="https://www.youtube.com/embed/HI704EY7gSs" 
            title="Vídeo de Caligrafia Chinesa - Stefany Shen" 
            frameborder="0" 
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
            allowfullscreen
          ></iframe>
        </div>
        
        <!-- Redirect to YouTube Channel -->
        <div class="mt-6 text-center">
          <p class="text-sm text-gray-400">
            Gostou da explicação? Inscreva-se no canal oficial para aulas gratuitas de apoio:
          </p>
          <a 
            href="https://www.youtube.com/@StefanyShen" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="mt-3 inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-brand-red/10 border border-brand-red/25 text-brand-red hover:bg-brand-red hover:text-white font-bold text-xs transition-all duration-300"
          >
            <span>📺 Ir para o canal @StefanyShen</span>
            <span class="text-xs">↗</span>
          </a>
        </div>
      </div>

      <!-- Testimonials grid (Leandro Ladeira style: conversational, breaking objections) -->
      <div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto pt-8 border-t border-white/5">
        
        <!-- Testimonial 1 -->
        <div class="glass-panel border border-white/5 p-6 rounded-2xl text-left">
          <p class="text-brand-gold text-lg mb-2">★★★★★</p>
          <p class="text-xs text-gray-300 font-sans leading-relaxed">
            "Eu sempre achei que desenhar esses caracteres era algo reservado a quem estudava há anos. Com a explicação da Stefany sobre a ordem dos traços, consegui escrever meu primeiro ideograma em 10 minutos e parecia de um profissional!"
          </p>
          <div class="mt-4 flex items-center gap-3">
            <span class="text-lg">👩‍🎓</span>
            <div>
              <p class="text-xs font-bold text-white">Mariana Santos</p>
              <p class="text-[10px] text-gray-400">Aluna Iniciante</p>
            </div>
          </div>
        </div>

        <!-- Testimonial 2 -->
        <div class="glass-panel border border-white/5 p-6 rounded-2xl text-left">
          <p class="text-brand-gold text-lg mb-2">★★★★★</p>
          <p class="text-xs text-gray-300 font-sans leading-relaxed">
            "O método é tão visual que você não precisa ficar decorando de forma chata. É como encaixar peças de quebra-cabeça. O vídeo no YouTube já abre os olhos, mas o manual em PDF organiza tudo de forma perfeita."
          </p>
          <div class="mt-4 flex items-center gap-3">
            <span class="text-lg">👨‍💻</span>
            <div>
              <p class="text-xs font-bold text-white">Felipe Schmidt</p>
              <p class="text-[10px] text-gray-400">Estudante de Mandarim</p>
            </div>
          </div>
        </div>

        <!-- Testimonial 3 -->
        <div class="glass-panel border border-white/5 p-6 rounded-2xl text-left">
          <p class="text-brand-gold text-lg mb-2">★★★★★</p>
          <p class="text-xs text-gray-300 font-sans leading-relaxed">
            "Uso a caligrafia chinesa à noite para desligar do trabalho. É uma meditação ativa fantástica. O manual ensina não apenas a forma, mas o significado cultural por trás do traço. Excelente custo-benefício!"
          </p>
          <div class="mt-4 flex items-center gap-3">
            <span class="text-lg">🧘‍♀️</span>
            <div>
              <p class="text-xs font-bold text-white">Carla Ribeiro</p>
              <p class="text-[10px] text-gray-400">Arquiteta</p>
            </div>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- BENEFITS OF THE MANUAL -->
  <section class="py-20 bg-black/20 border-t border-white/5 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-xs font-bold text-brand-gold tracking-widest uppercase mb-3 font-display">O que você vai aprender</h2>
        <h3 class="text-3xl sm:text-4xl font-display font-black text-white">Os 3 Pilares do Manual de Caligrafia</h3>
        <p class="mt-4 text-gray-400 font-sans">
          Cada página foi desenhada para desconstruir o complexo e te dar conquistas práticas desde o primeiro dia.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        
        <!-- Benefit 1 -->
        <div class="group glass-panel rounded-3xl p-8 border border-white/5 transition-all duration-300 hover:-translate-y-2 hover:border-brand-red/30">
          <div class="w-14 h-14 flex items-center justify-center bg-brand-red/10 rounded-full text-brand-red text-2xl mb-6">
            ✍️
          </div>
          <h4 class="font-display font-bold text-xl text-white mb-4">Ordem dos Traços do Zero</h4>
          <p class="text-gray-400 leading-relaxed font-sans text-sm">
            Mandarim tem regra. Você aprenderá as direções corretas de escrita (esquerda para a direita, cima para baixo) para que seus caracteres tenham o equilíbrio estético e a fluidez de um mestre tradicional.
          </p>
        </div>

        <!-- Benefit 2 -->
        <div class="group glass-panel rounded-3xl p-8 border border-white/5 transition-all duration-300 hover:-translate-y-2 hover:border-brand-gold/30">
          <div class="w-14 h-14 flex items-center justify-center bg-brand-gold/10 rounded-full text-brand-gold text-2xl mb-6">
            🧘
          </div>
          <h4 class="font-display font-bold text-xl text-white mb-4">Foco e Disciplina</h4>
          <p class="text-gray-400 leading-relaxed font-sans text-sm">
            A caligrafia tradicional chinesa é amplamente reconhecida como uma prática de foco e mindfulness. Ao se concentrar na precisão do traço, você treina sua mente, desacelera a respiração e reduz os níveis de estresse diários.
          </p>
        </div>

        <!-- Benefit 3 -->
        <div class="group glass-panel rounded-3xl p-8 border border-white/5 transition-all duration-300 hover:-translate-y-2 hover:border-brand-jade/30">
          <div class="w-14 h-14 flex items-center justify-center bg-brand-jade/10 rounded-full text-brand-jade text-2xl mb-6">
            🏮
          </div>
          <h4 class="font-display font-bold text-xl text-white mb-4">Significados Culturais</h4>
          <p class="text-gray-400 leading-relaxed font-sans text-sm">
            Mais do que riscar o papel: descubra a etimologia e a eufonia por trás dos principais caracteres. Aprenda a ler os conceitos ancestrais de harmonia, natureza e energia vital que moldam a cultura chinesa.
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- CLOSING / FINAL CALL TO ACTION -->
  <section class="py-24 relative overflow-hidden bg-gradient-to-b from-transparent to-black/50">
    <div class="absolute -bottom-16 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-brand-gold/5 rounded-full blur-[100px] pointer-events-none -z-10"></div>
    
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-8">
      
      <span class="text-5xl block animate-pulse">📜</span>
      
      <h3 class="text-3xl sm:text-5xl font-display font-black text-white leading-tight">
        Transforme sua Escrita em Arte!
      </h3>
      
      <p class="text-lg text-gray-300 font-sans max-w-2xl mx-auto">
        Não adie mais o seu sonho ou curiosidade de compreender a escrita mais antiga do mundo. Adquira agora o manual e dê o seu primeiro passo em direção ao domínio e relaxamento.
      </p>

      <div class="pt-4 flex flex-col items-center gap-4">
        <button 
          id="cta-final"
          class="px-12 py-6 text-center text-base font-extrabold bg-gradient-to-r from-brand-gold to-amber-400 text-dark-bg rounded-xl shadow-[0_4px_30px_rgba(251,191,36,0.4)] hover:shadow-[0_4px_40px_rgba(251,191,36,0.6)] hover:-translate-y-1 active:translate-y-0 transition-all duration-300 tracking-wider uppercase font-display cursor-pointer"
        >
          GARANTIR MEU MANUAL DE CALIGRAFIA CHINESA
        </button>
        
        <p class="text-xs text-gray-500 font-sans">
          Acesso imediato • E-book PDF de Alta Resolução • Pagamento Seguro Hotmart
        </p>
      </div>

    </div>
  </section>

  <!-- MODAL DE CHECKOUT -->
  <div class="modal-overlay" id="checkout-modal">
    <div class="modal-box">
      <div class="modal-seal">書</div>
      <h3>Antes de finalizar…</h3>
      <p>Gostaríamos genuinamente de saber:<br /><strong>Por que você quer aprender chinês?</strong></p>
      <textarea id="why-answer" placeholder="Ex: Quero entender melhor a cultura, fechar negócios com fornecedores chineses, viajar para a China…"></textarea>
      <div class="modal-actions">
        <button class="btn-cancel" id="modal-cancel">Agora não</button>
        <button class="btn-send" id="modal-send" disabled>Enviar e Finalizar 💬</button>
      </div>
      <p class="modal-whatsapp-note">🔒 Sua resposta será enviada pelo WhatsApp</p>
    </div>
  </div>

  <style>
    .modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 999;
      background: rgba(0,0,0,0.7);
      backdrop-filter: blur(4px);
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    .modal-overlay.active {
      display: flex;
    }
    .modal-box {
      background: linear-gradient(180deg, #1a1d28, #141824);
      border: 1px solid rgba(255,215,0,0.15);
      border-radius: 16px;
      padding: 36px 32px 28px;
      max-width: 480px;
      width: 100%;
      box-shadow: 0 20px 60px rgba(0,0,0,0.6);
      text-align: center;
      position: relative;
      animation: modal-in 0.3s ease;
    }
    @keyframes modal-in {
      from { opacity: 0; transform: scale(0.95) translateY(10px); }
      to { opacity: 1; transform: scale(1) translateY(0); }
    }
    .modal-seal {
      width: 48px; height: 48px;
      background: #c62828;
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 16px;
      border: 2px solid #7f0000;
      color: #fcf4dc;
      font-size: 18px;
      font-weight: 700;
      font-family: 'TW-Kai', 'Noto Sans SC', serif;
    }
    .modal-box h3 {
      font-size: 20px;
      color: #fff;
      margin-bottom: 8px;
      font-family: 'Nunito', sans-serif;
      font-weight: 800;
    }
    .modal-box p {
      font-size: 14px;
      color: #9ca3af;
      margin-bottom: 20px;
    }
    .modal-box textarea {
      width: 100%;
      padding: 14px 16px;
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 10px;
      font-family: 'Nunito', sans-serif;
      font-size: 14px;
      background: rgba(255,255,255,0.04);
      color: #e5e7eb;
      resize: vertical;
      min-height: 90px;
      outline: none;
      transition: border-color 0.2s;
    }
    .modal-box textarea:focus {
      border-color: #fbbf24;
    }
    .modal-box textarea::placeholder {
      color: #6b7280;
    }
    .modal-actions {
      display: flex;
      gap: 12px;
      margin-top: 18px;
      flex-wrap: wrap;
      justify-content: center;
    }
    .modal-actions button {
      padding: 12px 28px;
      border: none;
      border-radius: 10px;
      font-family: 'Nunito', sans-serif;
      font-weight: 700;
      font-size: 13px;
      cursor: pointer;
      transition: all 0.2s;
    }
    .btn-send {
      background: linear-gradient(135deg, #fbbf24, #f59e0b);
      color: #1a1d28;
      flex: 1;
    }
    .btn-send:hover { opacity: 0.9; }
    .btn-cancel {
      background: rgba(255,255,255,0.06);
      color: #9ca3af;
      border: 1px solid rgba(255,255,255,0.08) !important;
    }
    .btn-cancel:hover { background: rgba(255,255,255,0.1); }
    .btn-send:disabled {
      opacity: 0.3;
      cursor: not-allowed;
    }
    .modal-whatsapp-note {
      font-size: 12px;
      color: #6b7280;
      margin-top: 12px;
    }
  </style>

  <script>
    (function() {
      const phone = '5511996990939';
      const paymentUrl = 'https://pay.hotmart.com/placeholder';

      const modal = document.getElementById('checkout-modal');
      const textarea = document.getElementById('why-answer');
      const sendBtn = document.getElementById('modal-send');
      const cancelBtn = document.getElementById('modal-cancel');
      const heroCta = document.getElementById('cta-hero');
      const finalCta = document.getElementById('cta-final');

      function openModal() {
        modal.classList.add('active');
        textarea.value = '';
        sendBtn.disabled = true;
        textarea.focus();
      }

      textarea.addEventListener('input', function() {
        sendBtn.disabled = this.value.trim().length < 3;
      });

      function sendWhatsApp() {
        const answer = textarea.value.trim();
        if (answer.length < 3) return;

        const msg = encodeURIComponent(
          '📖 *Resposta do Modal - Manual de Caligrafia Chinesa*\n\n' +
          '✍️ *Por que você quer aprender chinês?*\n' +
          answer
        );
        const waUrl = 'https://wa.me/' + phone + '?text=' + msg;

        sendBtn.disabled = true;
        sendBtn.textContent = 'Enviando…';
        window.open(waUrl, '_blank');

        setTimeout(function() {
          modal.classList.remove('active');
          window.open(paymentUrl, '_blank');
        }, 1200);
      }

      function closeModal() {
        modal.classList.remove('active');
        window.open(paymentUrl, '_blank');
      }

      heroCta.addEventListener('click', openModal);
      finalCta.addEventListener('click', openModal);
      sendBtn.addEventListener('click', sendWhatsApp);
      cancelBtn.addEventListener('click', closeModal);

      modal.addEventListener('click', function(e) {
        if (e.target === modal) closeModal();
      });

      textarea.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' && !e.shiftKey) {
          e.preventDefault();
          if (!sendBtn.disabled) sendWhatsApp();
        }
      });
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modal.classList.contains('active')) closeModal();
      });
    })();
  </script>
</Layout>
