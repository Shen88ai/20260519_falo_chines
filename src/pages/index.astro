---
import Layout from '../layouts/Layout.astro';
import HanziWheel from '../components/HanziWheel.astro';
import FormNivelamento from '../components/FormNivelamento.astro';
import PergaminhoVirtual from '../components/PergaminhoVirtual.astro';
import { 
  courses, 
  specialCourses, 
  stefanyShen, 
  translationService, 
  differentials, 
  getWhatsAppEnrollUrl, 
  getWhatsAppQuoteUrl,
  CONTACT_PHONE
} from '../lib/courses-data';
---

<Layout>
  <!-- Floating Ribbon Banner for Chinese Calligraphy Manual -->
  <div class="relative z-30 bg-gradient-to-r from-brand-red via-brand-gold to-brand-jade text-dark-bg font-sans overflow-hidden border-b border-white/5">
    <div class="absolute inset-0 bg-white/10 animate-pulse pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 flex flex-col sm:flex-row items-center justify-center gap-3 text-center">
      <div class="flex items-center flex-wrap justify-center gap-2">
        <span class="px-2 py-0.5 rounded bg-black text-brand-gold text-[9px] font-black uppercase tracking-widest">
          LANÇAMENTO
        </span>
        <p class="text-xs sm:text-sm font-extrabold text-black tracking-wide">
          Aprenda a ordem dos traços e os significados milenares com o novo <strong class="text-black">Manual de Caligrafia Chinesa</strong>!
        </p>
      </div>
      <div class="flex items-center gap-2">
        <a 
          href="/manual" 
          class="inline-flex items-center gap-1 px-3 py-1.5 text-[10px] font-black bg-black/80 text-white hover:bg-black rounded-full transition-all duration-300 transform hover:scale-105 active:scale-95 shadow-md uppercase tracking-wider font-display"
        >
          <span>📘</span>
          <span>Versão Clássica</span>
        </a>
        <a 
          href="/manual-v2" 
          class="inline-flex items-center gap-1 px-3 py-1.5 text-[10px] font-black bg-black/80 text-brand-gold hover:bg-black hover:text-brand-gold rounded-full transition-all duration-300 transform hover:scale-105 active:scale-95 shadow-md uppercase tracking-wider font-display"
        >
          <span>🖊️</span>
          <span>Versão Reflexão</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Floating Ribbon Banner for Nome Chinês Service -->
  <div class="relative z-20 bg-gradient-to-r from-[#8B0000] via-brand-gold to-brand-red text-dark-bg font-sans overflow-hidden border-b border-white/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex flex-col sm:flex-row items-center justify-center gap-3 text-center">
      <span class="px-2 py-0.5 rounded bg-black text-brand-gold text-[9px] font-black uppercase tracking-widest">
        NOVO
      </span>
      <p class="text-xs sm:text-sm font-extrabold text-black tracking-wide">
        Seu nome em chinês em <strong class="text-black">3 estilos exclusivos</strong> — tinta, digital e translúcido!
      </p>
      <a 
        href="/nome-chines" 
        class="inline-flex items-center gap-1 px-3 py-1.5 text-[10px] font-black bg-black/80 text-white hover:bg-black rounded-full transition-all duration-300 uppercase tracking-wider"
      >
        <span>🀄</span>
        <span>Nome Chinês</span>
      </a>
    </div>
  </div>

  <!-- Hero Section with Premium Visuals -->
  <section class="relative min-h-[90vh] flex items-center justify-center pt-24 pb-16 overflow-hidden">
    <!-- Starry background or gradient effects -->
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(251,191,36,0.03),transparent_60%)] pointer-events-none"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_bottom,rgba(239,68,68,0.015),transparent_60%)] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left text content -->
      <div class="lg:col-span-6 space-y-6 text-center lg:text-left">
<span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-brand-gold/10 border border-brand-gold/25 text-xs font-bold text-brand-gold tracking-widest uppercase">
  🚀 MÉTODOS MODERNOS DE APRENDIZADO
</span>
<h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-black tracking-tight text-white leading-none">
  Sua ponte de negócios e fluência entre o Brasil e a China
</h1>
        <p class="text-base sm:text-lg text-gray-300 max-w-xl mx-auto lg:mx-0 leading-relaxed font-sans font-light">
          Uma plataforma revolucionária que une lições personalizadas com análise de voz em tempo real via **Web Audio API** para esculpir sua pronúncia tonal perfeita.
        </p>

        <!-- CTAs -->
<div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-4">
           <a 
             href="/servicos-empresariais" 
             class="w-full sm:w-auto px-8 py-3.5 rounded-full text-center text-xs font-extrabold bg-gradient-to-r from-brand-red to-brand-gold text-white hover:shadow-[0_0_25px_rgba(251,191,36,0.4)] transition-all duration-300 transform hover:-translate-y-0.5"
           >
             Preciso de Tradução/Consultoria
           </a>
           <a 
             href="/imersao-mandarim" 
             class="w-full sm:w-auto px-6 py-3.5 rounded-full text-center text-xs font-bold bg-white/5 hover:bg-white/10 border border-white/20 text-white transition-all duration-300"
           >
             Quero Aprender Mandarim
           </a>
         </div>

        <!-- Micro stats -->
        <div class="flex items-center justify-center lg:justify-start gap-8 pt-8 border-t border-white/5 text-gray-400">
          <div class="flex flex-col">
            <span class="font-display font-bold text-2xl text-brand-gold">4</span>
            <span class="text-[10px] uppercase tracking-wider font-semibold">Rotas de Fluência</span>
          </div>
          <div class="h-8 w-[1px] bg-white/10"></div>
          <div class="flex flex-col">
            <span class="font-display font-bold text-2xl text-brand-jade">100%</span>
            <span class="text-[10px] uppercase tracking-wider font-semibold">Microfone Local (Privacidade)</span>
          </div>
          <div class="h-8 w-[1px] bg-white/10"></div>
          <div class="flex flex-col">
            <span class="font-display font-bold text-2xl text-brand-purple">100%</span>
            <span class="text-[10px] uppercase tracking-wider font-semibold">Conteúdo Original</span>
          </div>
        </div>
      </div>

      <!-- Right interactive 3D scene -->
      <div class="lg:col-span-6 flex items-center justify-center relative">
        <HanziWheel />
      </div>

    </div>
  </section>

  <!-- Interactive Leveling/Diagnosis Section -->
  <section class="py-20 border-t border-white/5 bg-black/20" id="diagnostic-section">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="text-3xl font-display font-extrabold text-white tracking-tight">
          Descubra Seu Caminho Pedagógico
        </h2>
        <p class="text-xs sm:text-sm text-gray-400 mt-2">
          Responda a 3 rápidas perguntas elaboradas por nosso mentor virtual para desbloquear seu pergaminho de estudos personalizado e lições exclusivas.
        </p>
      </div>

      <FormNivelamento />
     <!-- Ensino & Tradução Profissional / Sobre Nós Section -->
  <section class="py-20 border-t border-white/5 bg-gradient-to-b from-black/35 to-black/20" id="sobre-nos">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Title -->
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-brand-gold/10 border border-brand-gold/25 text-xs font-bold text-brand-gold tracking-widest uppercase">
          ✨ ENSINO & TRADUÇÃO PROFISSIONAL
        </span>
        <h2 class="text-3xl sm:text-4xl font-display font-black text-white tracking-tight">
          Conectando Você com a China e o Mundo Asiático
        </h2>
        <p class="text-xs sm:text-sm text-gray-400 max-w-2xl mx-auto leading-relaxed">
          Com mais de 20 anos de experiência internacional em educação e diplomacia linguística, oferecemos soluções completas para impulsionar sua jornada acadêmica e comercial.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-stretch">
        
        <!-- Stefany Shen Card (Sobre Nós) -->
        <div class="lg:col-span-7 glass-panel rounded-3xl p-8 border border-white/5 relative overflow-hidden flex flex-col justify-between shadow-2xl">
          <div class="absolute -right-12 -top-12 w-32 h-32 bg-brand-gold/5 rounded-full filter blur-2xl"></div>
          
          <div class="space-y-6">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div class="flex items-center gap-4">
                <div class="w-16 h-16 rounded-2xl bg-gradient-to-tr from-brand-red to-brand-gold flex items-center justify-center text-3xl border border-white/10 shadow-lg">
                  👩‍💼
                </div>
                <div>
                  <h3 class="font-display font-black text-xl text-white tracking-tight">{stefanyShen.name}</h3>
                  <p class="text-xs text-brand-gold font-bold uppercase tracking-wider">Fundadora, Professora & Intérprete</p>
                </div>
              </div>
              
              <!-- Transcultural Flags -->
              <div class="flex items-center gap-2 bg-white/5 border border-white/10 px-3 py-1.5 rounded-full">
                <span class="text-xs text-gray-400 font-bold uppercase tracking-wider mr-1">Roteiro:</span>
                <span class="text-lg filter drop-shadow-md" title="Nascida em Taiwan">🇹🇼</span>
                <span class="text-xs text-gray-500">➔</span>
                <span class="text-lg filter drop-shadow-md" title="Criada no Paraguai">🇵🇾</span>
                <span class="text-xs text-gray-500">➔</span>
                <span class="text-lg filter drop-shadow-md" title="Educada no Chile">🇨🇱</span>
                <span class="text-xs text-gray-500">➔</span>
                <span class="text-lg filter drop-shadow-md" title="Residente no Brasil">🇧🇷</span>
              </div>
            </div>
            
            <div class="space-y-4 text-sm text-gray-300 leading-relaxed font-light">
              <p>
                Com mais de <strong class="text-brand-gold font-semibold">20 anos de experiência</strong> no mercado de ensino de Mandarim em São Paulo e atuação internacional de destaque como intérprete e tradutora técnica, oferecemos cursos exclusivos e serviços linguísticos sob medida.
              </p>
              <p>
                Nosso método exclusivo <strong class="text-brand-jade font-semibold">Right Brain Chinese</strong> combina prática intensiva, imersão na cultura e na filosofia chinesa, estimulando o hemisfério cerebral direito para garantir um aprendizado rápido, natural e extremamente eficaz.
              </p>
            </div>
          </div>

          <div class="mt-8 pt-6 border-t border-white/5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div class="flex items-center gap-2 text-xs text-gray-400">
              <span class="text-brand-gold">🎯</span>
              <span><strong>Missão:</strong> {stefanyShen.mission}</span>
            </div>
            <a 
              href={`https://wa.me/${CONTACT_PHONE}?text=${encodeURIComponent('Olá, gostaria de falar com a professora Stefany sobre os cursos e serviços.')}`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto px-5 py-2.5 rounded-full text-center text-xs font-bold bg-white/5 hover:bg-white/10 border border-white/10 text-gray-200 transition-all"
            >
              Falar com Stefany 💬
            </a>
          </div>
        </div>

        <!-- Diferenciais Checklist (Brainstorming) -->
        <div class="lg:col-span-5 flex flex-col gap-4">
          <h3 class="text-xs font-bold text-gray-400 uppercase tracking-widest pl-2 mb-1 flex items-center gap-2">
            <span>⚡</span> Diferenciais de Sucesso
          </h3>
          
          {differentials.map((diff, index) => {
            const icons = ['🧠', '🎯', '🌍', '💻'];
            const titles = ['Método Exclusivo', 'Praticidade & Foco', 'Expertise Global', 'Flexibilidade Total'];
            const colors = ['hover:border-brand-red/30', 'hover:border-brand-gold/30', 'hover:border-brand-purple/30', 'hover:border-brand-blue/30'];
            const bgGlows = ['bg-brand-red/5', 'bg-brand-gold/5', 'bg-brand-purple/5', 'bg-brand-blue/5'];
            
            return (
              <div class={`group glass-panel rounded-2xl p-5 border border-white/5 transition-all duration-300 flex items-start gap-4 hover:-translate-x-1 ${colors[index]}`}>
                <div class={`w-10 h-10 rounded-xl ${bgGlows[index]} flex items-center justify-center text-xl shrink-0 border border-white/5 group-hover:scale-110 transition-transform`}>
                  {icons[index]}
                </div>
                <div>
                  <h4 class="font-display font-bold text-xs uppercase tracking-wider text-white mb-1">{titles[index]}</h4>
                  <p class="text-xs text-gray-400 leading-relaxed font-light">{diff}</p>
                </div>
              </div>
            );
          })}
        </div>

      </div>
    </div>
</section>

<!-- Pergaminho Virtual — Call to Action Manual de Caligrafia -->
<PergaminhoVirtual />

<!-- B2B: Tradução, Interpretação e Facilitação Comercial Section -->
<section class="py-20 border-t border-white/5 bg-gradient-to-b from-black/20 to-black/30" id="servicos-empresariais">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Title -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-brand-blue/10 border border-brand-blue/25 text-xs font-bold text-brand-blue tracking-widest uppercase">
        💼 SERVIÇOS PARA EMPRESAS
      </span>
      <h2 class="text-3xl sm:text-4xl font-display font-black text-white tracking-tight">
        Tradução, Interpretação e Facilitação Comercial Brasil-China
      </h2>
      <p class="text-sm text-gray-300 max-w-xl mx-auto leading-relaxed">
        Não fazemos apenas tradução literal - oferecemos adequação cultural e técnica para seus negócios com a China.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <!-- B2B Content -->
      <div class="lg:col-span-6 space-y-8">
        <h3 class="text-2xl font-display font-bold text-white mb-4">Como ajudamos empresas paulistanas a terem sucesso com a China</h3>
        
        <div class="space-y-6">
          <div class="flex items-start gap-4 p-4 bg-white/5 rounded-xl border border-white/5">
            <div class="flex-shrink-0 w-10 h-10 flex items-center justify-center bg-brand-blue/10 rounded-full text-brand-blue">
              🤝
            </div>
            <div>
              <h4 class="font-display font-bold text-xs text-white">Tradução Técnica Especializada</h4>
              <p class="text-xs text-gray-300 leading-relaxed">
                Conferência do código HS brasileiro (NCM), validação de documentos de importação/exportação (conhecimento de embarque, packing list, certificados de origem) e adaptação de contratos comerciais para o mercado chinês.
              </p>
            </div>
          </div>
          
          <div class="flex items-start gap-4 p-4 bg-white/5 rounded-xl border border-white/5">
            <div class="flex-shrink-0 w-10 h-10 flex items-center justify-center bg-brand-gold/10 rounded-full text-brand-gold">
              📄
            </div>
            <div>
              <h4 class="font-display font-bold text-xs text-white">Interpretação para Negócios</h4>
              <p class="text-xs text-gray-300 leading-relaxed">
                Simultânea e consecutiva para reuniões, feiras (Canton Fair), visitas a fábricas e rodadas de investimento. Entendemos que negócios na China vão além do idioma - envolvem mianzi (面子) e guanxi (关系).
              </p>
            </div>
          </div>
          
          <div class="flex items-start gap-4 p-4 bg-white/5 rounded-xl border border-white/5">
            <div class="flex-shrink-0 w-10 h-10 flex items-center justify-center bg-brand-purple/10 rounded-full text-brand-purple">
              🌉
            </div>
            <div>
              <h4 class="font-display font-bold text-xs text-white">Facilitação Comercial</h4>
              <p class="text-xs text-gray-300 leading-relaxed">
                Ponte cultural para evitar armadilhas de comunicação, análise de propostas chinesas e apoio em negociações para garantir que suas intenções sejam corretamente transmitidas e compreendidas.
              </p>
            </div>
          </div>
        </div>
        
        <!-- Testimonial -->
        <div class="p-6 bg-white/5 border border-white/5 rounded-xl">
          <p class="text-italic text-gray-300 leading-relaxed">
            "O Falo Chinês identificou erros críticos em nossos documentos de exportação que nos custariam multas evitáveis. Seu serviço vai muito além da tradução - é uma verdadeira assessoria de comércio exterior."
          </p>
          <p class="mt-4 text-xs text-gray-400 text-right font-bold">— Carlos M., Diretor de Compras, Importadora SP</p>
        </div>
      </div>
      
      <!-- B2C/Training Section -->
      <div class="lg:col-span-6 space-y-8">
        <h3 class="text-2xl font-display font-bold text-white mb-4">Imersão em Mandarim para Profissionais e Estudantes de Carreira</h3>
        
        <div class="space-y-6">
          <div class="flex items-start gap-4 p-4 bg-white/5 rounded-xl border border-white/5">
            <div class="flex-shrink-0 w-10 h-10 flex items-center justify-center bg-brand-jade/10 rounded-full text-brand-jade">
              🎯
            </div>
            <div>
              <h4 class="font-display font-bold text-xs text-white">Foco Prático e Sem Enrolação</h4>
              <p class="text-xs text-gray-300 leading-relaxed">
                Aprenda frases que você usa NA SEMANA que vem - nada de teoria inútil, tudo aplicável imediatamente ao seu contexto profissional ou de viagem.
              </p>
            </div>
          </div>
          
          <div class="flex items-start gap-4 p-4 bg-white/5 rounded-xl border border-white/5">
            <div class="flex-shrink-0 w-10 h-10 flex items-center justify-center bg-brand-red/10 rounded-full text-brand-red">
              🎭
            </div>
            <div>
              <h4 class="font-display font-bold text-xs text-white">Simulações de Situações Reais</h4>
              <p class="text-xs text-gray-300 leading-relaxed">
                Pratique cenários como: check-in no aeroporto de Guarulhos para voos para Xangai, jantar de negócios com fornecedores chineses, visita a fábricas em Guangdong e negociação no Alibaba.
              </p>
            </div>
          </div>
          
          <div class="flex items-start gap-4 p-4 bg-white/5 rounded-xl border border-white/5">
            <div class="flex-shrink-0 w-10 h-10 flex items-center justify-center bg-brand-blue/10 rounded-full text-brand-blue">
              🎧
            </div>
            <div>
              <h4 class="font-display font-bold text-xs text-white">Suporte Dinâmico e Contínuo</h4>
              <p class="text-xs text-gray-300 leading-relaxed">
                Áudios nativos por WhatsApp para revisão diária, flashcards personalizados por tema e correção de pronúncia em tempo real através da nossa plataforma.
              </p>
            </div>
          </div>
        </div>
        
        <!-- Differentiator -->
        <div class="p-6 bg-white/5 border border-white/5 rounded-xl">
          <h4 class="font-display font-bold text-xs text-white mb-2">Nosso Diferencial</h4>
          <p class="text-xs text-gray-300 leading-relaxed">
            Não ensinamos apenas idioma - ensinamos a fazer negócios na China. Nosso método baseado na abordagem da "Mãe Chinesa" combina imersão afetiva com repetição consciente, garantindo que você não apenas decore caracteres, mas realmente compreenda e use o mandarim em contextos reais.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Diagnóstico China Banner -->
  <section class="py-12 border-t border-white/5 bg-gradient-to-r from-brand-gold/5 via-black/50 to-brand-red/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="glass-panel rounded-3xl p-8 sm:p-10 border-2 border-brand-gold/30 relative overflow-hidden">
        <div class="absolute -right-16 -top-16 w-48 h-48 bg-brand-gold/10 rounded-full filter blur-3xl pointer-events-none"></div>
        <div class="absolute -left-16 -bottom-16 w-48 h-48 bg-brand-red/10 rounded-full filter blur-3xl pointer-events-none"></div>
        <div class="flex flex-col lg:flex-row items-center gap-6 relative z-10">
          <div class="flex-1 text-center lg:text-left">
            <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-gold/15 border border-brand-gold/25 text-xs font-bold text-brand-gold tracking-widest uppercase mb-3">
              🎁 DIAGNÓSTICO GRATUITO
            </span>
            <h3 class="text-2xl sm:text-3xl font-display font-black text-white leading-tight mb-2">
              Descubra em que fase está seu negócio com a China
            </h3>
            <p class="text-gray-300 text-sm sm:text-base max-w-xl leading-relaxed">
              Quiz rápido de 7 perguntas + recomendação personalizada. <strong class="text-brand-gold">Hoje é grátis</strong> — valor original R$ 247.
            </p>
            <div class="mt-3 flex items-center gap-3 text-xs text-gray-500 justify-center lg:justify-start">
              <span class="flex items-center gap-1">📝 2 minutos</span>
              <span class="w-1 h-1 rounded-full bg-gray-600"></span>
              <span class="flex items-center gap-1">📲 resultado via WhatsApp</span>
              <span class="w-1 h-1 rounded-full bg-gray-600"></span>
              <span class="flex items-center gap-1 line-through text-gray-600">R$ 247</span>
              <span class="text-brand-gold font-black">GRÁTIS</span>
            </div>
          </div>
          <div class="flex-shrink-0 flex flex-col sm:flex-row items-center gap-3">
            <a 
              href="/diagnostico-china"
              class="inline-block px-8 py-4 bg-gradient-to-r from-brand-gold to-amber-400 text-dark-bg font-extrabold rounded-full text-sm hover:shadow-[0_0_30px_rgba(251,191,36,0.5)] transition-all duration-300 transform hover:-translate-y-1 animate-pulse"
            >
              Quero meu diagnóstico grátis 🎯
            </a>
            <span class="text-[10px] text-gray-500 font-bold uppercase tracking-wider">vagas limitadas</span>
          </div>
        </div>
      </div>
    </div>
  </section>

<!-- Consultoria Negociação com Chineses Banner -->
  <section class="py-16 border-t border-white/5 bg-gradient-to-r from-brand-red/5 via-black/40 to-brand-gold/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="glass-panel rounded-3xl p-8 sm:p-10 border border-brand-gold/20 relative overflow-hidden">
        <div class="absolute -right-20 -top-20 w-60 h-60 bg-brand-gold/5 rounded-full filter blur-3xl pointer-events-none"></div>
