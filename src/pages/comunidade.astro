---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Comunidade - Falo Chinês" description="Participe da comunidade Falo Chinês: peça situações, registre dificuldades e compartilhe macetes.">
  <div class="py-10 bg-[radial-gradient(circle_at_top,rgba(251,191,36,0.02),transparent_45%)]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="mb-8 text-center">
        <h1 class="text-3xl sm:text-4xl font-display font-black text-white">🤝 Comunidade Falo Chinês</h1>
        <p class="text-sm text-gray-400 mt-2 max-w-lg mx-auto">
          Contribua com seu conhecimento, peça ajuda onde trava e veja o que outros alunos estão aprendendo.
        </p>
      </div>

      <div class="flex border-b border-white/10 mb-8" id="comunidade-tabs">
        <a href="#situacoes" class="comunidade-tab flex-1 text-center py-3 text-xs font-bold uppercase tracking-wider text-gray-400 hover:text-brand-gold border-b-2 border-transparent transition-all" data-tab="situacoes">🗣️ Situações</a>
        <a href="#dificuldades" class="comunidade-tab flex-1 text-center py-3 text-xs font-bold uppercase tracking-wider text-gray-400 hover:text-brand-gold border-b-2 border-transparent transition-all" data-tab="dificuldades">🔍 Dificuldades</a>
        <a href="#macetes" class="comunidade-tab flex-1 text-center py-3 text-xs font-bold uppercase tracking-wider text-gray-400 hover:text-brand-gold border-b-2 border-transparent transition-all" data-tab="macetes">🧠 Macetes</a>
      </div>

      <div id="comunidade-content">
        <div id="tab-situacoes" class="comunidade-panel"></div>
        <div id="tab-dificuldades" class="comunidade-panel hidden"></div>
        <div id="tab-macetes" class="comunidade-panel hidden"></div>
      </div>

    </div>
  </div>
</Layout>

<script>
  const tabs = document.querySelectorAll('.comunidade-tab');
  const panels = {
    situacoes: document.getElementById('tab-situacoes'),
    dificuldades: document.getElementById('tab-dificuldades'),
    macetes: document.getElementById('tab-macetes'),
  };

  function activateTab(hash) {
    const tabId = hash.replace('#', '') || 'situacoes';
    tabs.forEach(t => {
      const isActive = t.getAttribute('data-tab') === tabId;
      t.classList.toggle('text-brand-gold', isActive);
      t.classList.toggle('text-gray-400', !isActive);
      t.classList.toggle('border-brand-gold', isActive);
      t.classList.toggle('border-transparent', !isActive);
    });
    Object.entries(panels).forEach(([id, el]) => {
      if (el) el.classList.toggle('hidden', id !== tabId);
    });
  }

  activateTab(window.location.hash);
  window.addEventListener('hashchange', () => activateTab(window.location.hash));

  tabs.forEach(tab => {
    tab.addEventListener('click', e => {
      e.preventDefault();
      const tabId = tab.getAttribute('data-tab');
      if (tabId) window.location.hash = tabId;
    });
  });

  async function mountBoards() {
    const storage = await import('../lib/comunidade-storage');
    storage.seedInitialData();

    const situacoesEl = document.getElementById('tab-situacoes');
    const dificuldadesEl = document.getElementById('tab-dificuldades');
    const macetesEl = document.getElementById('tab-macetes');

    if (situacoesEl) renderSituacaoBoard(situacoesEl, storage);
    if (dificuldadesEl) renderDificuldadeBoard(dificuldadesEl, storage);
    if (macetesEl) renderMaceteBoard(macetesEl, storage);
  }

  function renderSituacaoBoard(container, storage) {
    const list = storage.getSituations();
    const sorted = [...list].sort((a, b) => b.votes - a.votes);

    const statusColors = {
      pendente: 'text-yellow-400 bg-yellow-400/10 border-yellow-400/20',
      'em andamento': 'text-blue-400 bg-blue-400/10 border-blue-400/20',
      publicado: 'text-brand-jade bg-brand-jade/10 border-brand-jade/20',
    };
    const statusLabels = { pendente: 'Pendente', 'em andamento': 'Em andamento', publicado: 'Publicado ✓' };

    let html = `
      <div class="mb-6">
        <button id="btn-nova-situacao" class="text-xs font-bold uppercase tracking-wider px-4 py-2.5 rounded-xl bg-brand-gold/20 text-brand-gold hover:bg-brand-gold/30 border border-brand-gold/30 transition-all">➕ Nova Situação</button>
      </div>
      <div id="form-nova-situacao" class="hidden glass-panel rounded-xl p-5 border border-white/5 mb-6">
        <input id="input-situacao-title" type="text" placeholder="Título da situação..." class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-sm text-white placeholder-gray-500 mb-2 focus:outline-none focus:border-brand-gold/50">
        <textarea id="input-situacao-desc" placeholder="Descreva a situação em detalhes..." class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-sm text-white placeholder-gray-500 mb-2 focus:outline-none focus:border-brand-gold/50" rows="2"></textarea>
        <input id="input-situacao-tags" type="text" placeholder="Tags: restaurante, viagem..." class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-sm text-white placeholder-gray-500 mb-3 focus:outline-none focus:border-brand-gold/50">
        <div class="flex gap-2">
          <button id="btn-situacao-submit" class="text-xs font-bold px-4 py-2 rounded-lg bg-brand-gold/20 text-brand-gold hover:bg-brand-gold/30 border border-brand-gold/30 transition-all">Enviar</button>
          <button id="btn-situacao-cancel" class="text-xs font-bold px-4 py-2 rounded-lg bg-white/5 text-gray-400 hover:text-white border border-white/10 transition-all">Cancelar</button>
        </div>
      </div>
      <div class="space-y-3">
    `;

    sorted.forEach(s => {
      const statusColor = statusColors[s.status] || statusColors.pendente;
      const statusLabel = statusLabels[s.status] || s.status;
      html += `
        <div class="glass-panel rounded-xl p-4 sm:p-5 border border-white/5">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0 flex-1">
              <h4 class="text-sm font-display font-bold text-white">${escapeHtml(s.title)}</h4>
              <p class="text-[11px] text-gray-400 mt-1">${escapeHtml(s.description)}</p>
              <div class="flex items-center gap-2 mt-2 flex-wrap">
                ${s.tags.map(t => `<span class="text-[9px] px-2 py-0.5 rounded-full bg-white/5 text-gray-400 border border-white/5">${escapeHtml(t)}</span>`).join('')}
                <span class="text-[9px] px-2 py-0.5 rounded-full ${statusColor} border">${statusLabel}</span>
              </div>
              <span class="block text-[9px] text-gray-500 mt-2">por ${escapeHtml(s.author)}</span>
            </div>
            <div class="flex flex-col items-center gap-0.5 shrink-0">
              <button class="situacao-vote text-lg text-gray-400 hover:text-brand-gold transition-colors" data-id="${s.id}">👍</button>
              <span class="text-xs font-bold text-white">${s.votes}</span>
            </div>
          </div>
        </div>
      `;
    });

    html += `</div>`;
    container.innerHTML = html;

    document.getElementById('btn-nova-situacao')?.addEventListener('click', () => {
      const form = document.getElementById('form-nova-situacao');
      if (form) form.classList.toggle('hidden');
    });
    document.getElementById('btn-situacao-cancel')?.addEventListener('click', () => {
      const form = document.getElementById('form-nova-situacao');
      if (form) form.classList.add('hidden');
    });
    document.getElementById('btn-situacao-submit')?.addEventListener('click', () => {
      const title = document.getElementById('input-situacao-title');
      const desc = document.getElementById('input-situacao-desc');
      const tags = document.getElementById('input-situacao-tags');
      if (!title || !desc || !title.value.trim()) return;
      const tagList = tags ? tags.value.split(',').map(t => t.trim()).filter(Boolean) : [];
      storage.addSituation(title.value.trim(), desc.value.trim(), tagList);
      title.value = '';
      if (desc) desc.value = '';
      if (tags) tags.value = '';
      renderSituacaoBoard(container, storage);
    });
    document.querySelectorAll('.situacao-vote').forEach(btn => {
      btn.addEventListener('click', function () {
        storage.voteSituation(this.getAttribute('data-id'));
        renderSituacaoBoard(container, storage);
      });
    });
  }

  function renderDificuldadeBoard(container, storage) {
    const list = storage.getDifficulties();
    const byChar = {};
    list.forEach(d => {
      if (!byChar[d.character]) byChar[d.character] = { character: d.character, total: 0, types: {} };
      byChar[d.character].total++;
      byChar[d.character].types[d.type] = (byChar[d.character].types[d.type] || 0) + 1;
    });
    const sorted = Object.values(byChar).sort((a, b) => b.total - a.total);

    const typeLabels = { tone: 'Tom', strokes: 'Traços', meaning: 'Significado', radical: 'Radical', other: 'Outro' };

    let html = `<div class="space-y-3">`;
    if (sorted.length === 0) {
      html += `<p class="text-gray-500 text-sm text-center py-12">Nenhuma dificuldade registrada ainda.</p>`;
    }
    sorted.forEach((item, i) => {
      const maxType = Object.entries(item.types).sort((a, b) => b[1] - a[1])[0];
      html += `
        <div class="glass-panel rounded-xl p-4 sm:p-5 border border-white/5 flex items-center gap-4">
          <span class="text-2xl font-extrabold text-white w-10 text-center font-serif-zh">${item.character}</span>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2">
              <span class="text-xs font-bold text-white">🔥 ${item.total}</span>
              <span class="text-[10px] text-gray-400">alunos</span>
            </div>
            <div class="flex items-center gap-2 mt-1 flex-wrap">
              <span class="text-[10px] text-gray-500">Principal: ${typeLabels[maxType[0]] || maxType[0]}</span>
              ${Object.entries(item.types).map(([t, c]) => `<span class="text-[9px] px-2 py-0.5 rounded-full bg-white/5 text-gray-400 border border-white/5">${typeLabels[t] || t}: ${c}</span>`).join('')}
            </div>
          </div>
          <span class="text-[10px] text-gray-500 shrink-0">#${i + 1}</span>
        </div>
      `;
    });
    html += `</div>`;
    container.innerHTML = html;
  }

  function renderMaceteBoard(container, storage) {
    const list = storage.getMnemonics();
    const sorted = [...list].sort((a, b) => b.votes - a.votes);

    let html = `
      <div class="mb-6">
        <button id="btn-novo-macete" class="text-xs font-bold uppercase tracking-wider px-4 py-2.5 rounded-xl bg-brand-gold/20 text-brand-gold hover:bg-brand-gold/30 border border-brand-gold/30 transition-all">🧠 Novo Macete</button>
      </div>
      <div id="form-novo-macete" class="hidden glass-panel rounded-xl p-5 border border-white/5 mb-6">
        <input id="input-macete-char" type="text" placeholder="Caractere (ex: 学)" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-sm text-white placeholder-gray-500 mb-2 focus:outline-none focus:border-brand-gold/50">
        <textarea id="input-macete-text" placeholder="Seu macete para memorizar..." class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-sm text-white placeholder-gray-500 mb-2 focus:outline-none focus:border-brand-gold/50" rows="2"></textarea>
        <input id="input-macete-author" type="text" placeholder="Seu nome" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-sm text-white placeholder-gray-500 mb-3 focus:outline-none focus:border-brand-gold/50">
        <div class="flex gap-2">
          <button id="btn-macete-submit" class="text-xs font-bold px-4 py-2 rounded-lg bg-brand-gold/20 text-brand-gold hover:bg-brand-gold/30 border border-brand-gold/30 transition-all">Enviar</button>
          <button id="btn-macete-cancel" class="text-xs font-bold px-4 py-2 rounded-lg bg-white/5 text-gray-400 hover:text-white border border-white/10 transition-all">Cancelar</button>
        </div>
      </div>
      <div class="space-y-3">
    `;

    sorted.forEach(m => {
      html += `
        <div class="glass-panel rounded-xl p-4 sm:p-5 border border-white/5 flex items-start gap-4">
          <span class="text-2xl font-extrabold text-white font-serif-zh w-10 text-center shrink-0">${m.character}</span>
          <div class="flex-1 min-w-0">
            <p class="text-sm text-gray-200">“${escapeHtml(m.text)}”</p>
            <div class="flex items-center gap-3 mt-2">
              <span class="text-[10px] text-gray-500">por ${escapeHtml(m.author)}</span>
              <button class="macete-vote text-xs text-gray-400 hover:text-brand-gold transition-colors flex items-center gap-1" data-id="${m.id}">
                👍 <span>${m.votes}</span>
              </button>
              ${m.votes >= 5 ? '<span class="text-[9px] px-2 py-0.5 rounded-full bg-brand-gold/10 text-brand-gold border border-brand-gold/20">✨ Destaque</span>' : ''}
            </div>
          </div>
        </div>
      `;
    });

    html += `</div>`;
    container.innerHTML = html;

    document.getElementById('btn-novo-macete')?.addEventListener('click', () => {
      const form = document.getElementById('form-novo-macete');
      if (form) form.classList.toggle('hidden');
    });
    document.getElementById('btn-macete-cancel')?.addEventListener('click', () => {
      const form = document.getElementById('form-novo-macete');
      if (form) form.classList.add('hidden');
    });
    document.getElementById('btn-macete-submit')?.addEventListener('click', () => {
      const char = document.getElementById('input-macete-char');
      const text = document.getElementById('input-macete-text');
      const author = document.getElementById('input-macete-author');
      if (!char || !text || !char.value.trim() || !text.value.trim()) return;
      storage.addMnemonic(char.value.trim(), text.value.trim(), author?.value.trim() || 'Anônimo');
      char.value = '';
      if (text) text.value = '';
      if (author) author.value = '';
      renderMaceteBoard(container, storage);
    });
    document.querySelectorAll('.macete-vote').forEach(btn => {
      btn.addEventListener('click', function () {
        storage.voteMnemonic(this.getAttribute('data-id'));
        renderMaceteBoard(container, storage);
      });
    });
  }

  function escapeHtml(str) {
    const div = document.createElement('div');
    div.appendChild(document.createTextNode(str));
    return div.innerHTML;
  }

  mountBoards();
</script>
