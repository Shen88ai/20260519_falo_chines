---
import Layout from '../layouts/Layout.astro';
import seedData from '../data/comunidade-data.json';

---

<Layout title="Comunidade - Falo Chinês" description="Participe da comunidade Falo Chinês: peça situações, registre dificuldades e compartilhe macetes.">
  <div class="py-10 bg-[radial-gradient(circle_at_top,rgba(251,191,36,0.02),transparent_45%)]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="mb-8 text-center">
        <h1 class="text-3xl sm:text-4xl font-display font-black text-white">🤝 Comunidade Falo Chinês</h1>
        <p class="text-sm text-gray-400 mt-2 max-w-lg mx-auto">
          Contribua com seu conhecimento, peça ajuda onde trava e veja o que outros alunos estão aprendendo.
        </p>
      </div>

      <div class="flex border-b border-white/10 mb-8" id="comunidade-tabs">
        <a href="#situacoes" class="comunidade-tab flex-1 text-center py-3 text-xs font-bold uppercase tracking-wider text-gray-400 hover:text-brand-gold border-b-2 border-transparent transition-all" data-tab="situacoes">🗣️ Situações</a>
        <a href="#dificuldades" class="comunidade-tab flex-1 text-center py-3 text-xs font-bold uppercase tracking-wider text-gray-400 hover:text-brand-gold border-b-2 border-transparent transition-all" data-tab="dificuldades">🔍 Dificuldades</a>
        <a href="#macetes" class="comunidade-tab flex-1 text-center py-3 text-xs font-bold uppercase tracking-wider text-gray-400 hover:text-brand-gold border-b-2 border-transparent transition-all" data-tab="macetes">🧠 Macetes</a>
        <a href="#comentarios" class="comunidade-tab flex-1 text-center py-3 text-xs font-bold uppercase tracking-wider text-gray-400 hover:text-brand-gold border-b-2 border-transparent transition-all" data-tab="comentarios">💬 Comentários</a>
      </div>

      <div id="comunidade-content">
        <div id="tab-situacoes" class="comunidade-panel"></div>
        <div id="tab-dificuldades" class="comunidade-panel hidden"></div>
        <div id="tab-macetes" class="comunidade-panel hidden"></div>
        <div id="tab-comentarios" class="comunidade-panel hidden"></div>
      </div>

    </div>
  </div>
</Layout>

<script define:vars={{ seedData: seedData }}>


  const tabs = document.querySelectorAll('.comunidade-tab');
  const panels = {
    situacoes: document.getElementById('tab-situacoes'),
    dificuldades: document.getElementById('tab-dificuldades'),
    macetes: document.getElementById('tab-macetes'),
    comentarios: document.getElementById('tab-comentarios'),
  };

  function activateTab(hash) {
    const tabId = hash.replace('#', '') || 'situacoes';
    tabs.forEach(t => {
      const isActive = t.getAttribute('data-tab') === tabId;
      t.classList.toggle('text-brand-gold', isActive);
      t.classList.toggle('text-gray-400', !isActive);
      t.classList.toggle('border-brand-gold', isActive);
      t.classList.toggle('border-transparent', !isActive);
    });
    Object.entries(panels).forEach(([id, el]) => {
      if (el) el.classList.toggle('hidden', id !== tabId);
    });
  }

  activateTab(window.location.hash);
  window.addEventListener('hashchange', () => activateTab(window.location.hash));

  tabs.forEach(tab => {
    tab.addEventListener('click', e => {
      e.preventDefault();
      const tabId = tab.getAttribute('data-tab');
      if (tabId) window.location.hash = tabId;
    });
  });

  function getLocal(key) {
    try { return JSON.parse(localStorage.getItem(key) || '[]'); } catch { return []; }
  }
  function setLocal(key, data) { localStorage.setItem(key, JSON.stringify(data)); }
  function uid() { return Date.now().toString(36) + Math.random().toString(36).slice(2, 8); }

  function mountBoards() {
    renderSituacaoBoard(document.getElementById('tab-situacoes'));
    renderDificuldadeBoard(document.getElementById('tab-dificuldades'));
    renderMaceteBoard(document.getElementById('tab-macetes'));
    renderComentarioBoard(document.getElementById('tab-comentarios'));
  }

  function dedupBy(arr, keyFn) {
    const seen = new Set();
    return arr.filter(item => {
      const key = keyFn(item);
      if (seen.has(key)) return false;
      seen.add(key);
      return true;
    });
  }

  function renderSituacaoBoard(container) {
    const fetched = seedData.situacoes || [];
    const local = getLocal('falo-chines-situations');
    const list = dedupBy([...fetched, ...local], s => s.title).sort((a, b) => b.votes - a.votes);

    const statusColors = {
      pendente: 'text-yellow-400 bg-yellow-400/10 border-yellow-400/20',
      'em andamento': 'text-blue-400 bg-blue-400/10 border-blue-400/20',
      publicado: 'text-brand-jade bg-brand-jade/10 border-brand-jade/20',
    };
    const statusLabels = { pendente: 'Pendente', 'em andamento': 'Em andamento', publicado: 'Publicado ✓' };

    let html = `
      <div class="mb-6 glass-panel rounded-xl p-4 sm:p-5 border border-white/5">
        <form class="inline-form" data-form="situacao">
          <h4 class="text-xs font-bold text-white mb-3 uppercase tracking-wider">➕ Sugerir Situação</h4>
          <input name="title" type="text" placeholder="Título da situação" required
            class="w-full mb-2 px-4 py-2 rounded-xl bg-white/5 border border-white/10 text-white text-sm placeholder-gray-500 focus:outline-none focus:border-brand-gold/50 transition-colors" />
          <textarea name="description" rows="2" placeholder="Descreva a situação..." required
            class="w-full mb-2 px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white text-sm placeholder-gray-500 focus:outline-none focus:border-brand-gold/50 transition-colors resize-none"></textarea>
          <input name="tags" type="text" placeholder="Tags (separadas por vírgula)"
            class="w-full mb-3 px-4 py-2 rounded-xl bg-white/5 border border-white/10 text-white text-sm placeholder-gray-500 focus:outline-none focus:border-brand-gold/50 transition-colors" />
          <div class="flex items-center justify-between">
            <button type="submit" class="text-xs font-bold uppercase tracking-wider px-4 py-2 rounded-xl bg-brand-gold/20 text-brand-gold hover:bg-brand-gold/30 border border-brand-gold/30 transition-all">Enviar</button>
            <span class="form-feedback text-[11px] text-brand-jade hidden" data-feedback="situacao">✓ Sugerido!</span>
          </div>
        </form>
      </div>
      <div class="space-y-3">
    `;

    if (list.length === 0) {
      html += `<p class="text-gray-500 text-sm text-center py-12">Nenhuma situação ainda. Seja o primeiro a sugerir!</p>`;
    }

    list.forEach(s => {
      const statusColor = statusColors[s.status] || statusColors.pendente;
      const statusLabel = statusLabels[s.status] || s.status;
      const lessonLink = s.lessonSlug ? `<a href="/licoes/${escapeHtml(s.lessonSlug)}" class="text-[9px] px-2 py-0.5 rounded-full bg-brand-blue/10 text-brand-blue border border-brand-blue/20 hover:bg-brand-blue/20 transition-colors">📖 ${escapeHtml(s.lessonSlug)}</a>` : '';
      html += `
        <div class="glass-panel rounded-xl p-4 sm:p-5 border border-white/5">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0 flex-1">
              <h4 class="text-sm font-display font-bold text-white">${escapeHtml(s.title)}</h4>
              <p class="text-[11px] text-gray-400 mt-1">${escapeHtml(s.description)}</p>
              <div class="flex items-center gap-2 mt-2 flex-wrap">
                ${(s.tags || []).map(t => `<span class="text-[9px] px-2 py-0.5 rounded-full bg-white/5 text-gray-400 border border-white/5">${escapeHtml(t)}</span>`).join('')}
                ${lessonLink}
                <span class="text-[9px] px-2 py-0.5 rounded-full ${statusColor} border">${statusLabel}</span>
              </div>
              <span class="block text-[9px] text-gray-500 mt-2">por ${escapeHtml(s.author || 'Anônimo')}</span>
            </div>
          </div>
        </div>
      `;
    });

    html += `</div>`;
    container.innerHTML = html;
  }

  function renderDificuldadeBoard(container) {
    const fetched = seedData.dificuldades || [];
    const local = getLocal('falo-chines-difficulties');
    const all = dedupBy([...fetched, ...local], d => d.character + '|' + d.type + '|' + d.lessonSlug);

    const byChar = {};
    all.forEach(d => {
      if (!byChar[d.character]) byChar[d.character] = { character: d.character, total: 0, types: {} };
      byChar[d.character].total++;
      byChar[d.character].types[d.type] = (byChar[d.character].types[d.type] || 0) + 1;
    });
    const sorted = Object.values(byChar).sort((a, b) => b.total - a.total);

    const typeLabels = { tone: 'Tom', strokes: 'Traços', meaning: 'Significado', radical: 'Radical', other: 'Outro' };

    let html = `<div class="space-y-3">`;
    if (sorted.length === 0) {
      html += `<p class="text-gray-500 text-sm text-center py-12">Nenhuma dificuldade registrada ainda. Clique em "Tive dificuldade" nos caracteres das lições!</p>`;
    }
    sorted.forEach((item, i) => {
      const maxType = Object.entries(item.types).sort((a, b) => b[1] - a[1])[0];
      html += `
        <div class="glass-panel rounded-xl p-4 sm:p-5 border border-white/5 flex items-center gap-4">
          <span class="text-2xl font-extrabold text-white w-10 text-center font-zh">${item.character}</span>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2">
              <span class="text-xs font-bold text-white">🔥 ${item.total}</span>
              <span class="text-[10px] text-gray-400">alunos</span>
            </div>
            <div class="flex items-center gap-2 mt-1 flex-wrap">
              <span class="text-[10px] text-gray-500">Principal: ${typeLabels[maxType[0]] || maxType[0]}</span>
              ${Object.entries(item.types).map(([t, c]) => `<span class="text-[9px] px-2 py-0.5 rounded-full bg-white/5 text-gray-400 border border-white/5">${typeLabels[t] || t}: ${c}</span>`).join('')}
            </div>
          </div>
          <span class="text-[10px] text-gray-500 shrink-0">#${i + 1}</span>
        </div>
      `;
    });
    html += `</div>`;
    container.innerHTML = html;
  }

  function renderMaceteBoard(container) {
    const fetched = seedData.macetes || [];
    const local = getLocal('falo-chines-mnemonics');
    const list = dedupBy([...fetched, ...local], m => m.character + '|' + m.text).sort((a, b) => b.votes - a.votes);

    let html = `
      <div class="mb-6 glass-panel rounded-xl p-4 sm:p-5 border border-white/5">
        <form class="inline-form" data-form="macete">
          <h4 class="text-xs font-bold text-white mb-3 uppercase tracking-wider">🧠 Compartilhar Macete</h4>
          <input name="character" type="text" placeholder="Caractere" required
            class="w-full mb-2 px-4 py-2 rounded-xl bg-white/5 border border-white/10 text-white text-sm placeholder-gray-500 focus:outline-none focus:border-brand-gold/50 transition-colors" />
          <textarea name="text" rows="2" placeholder="Seu macete..." required
            class="w-full mb-2 px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white text-sm placeholder-gray-500 focus:outline-none focus:border-brand-gold/50 transition-colors resize-none"></textarea>
          <input name="author" type="text" placeholder="Seu nome (opcional)"
            class="w-full mb-3 px-4 py-2 rounded-xl bg-white/5 border border-white/10 text-white text-sm placeholder-gray-500 focus:outline-none focus:border-brand-gold/50 transition-colors" />
          <div class="flex items-center justify-between">
            <button type="submit" class="text-xs font-bold uppercase tracking-wider px-4 py-2 rounded-xl bg-brand-gold/20 text-brand-gold hover:bg-brand-gold/30 border border-brand-gold/30 transition-all">Enviar</button>
            <span class="form-feedback text-[11px] text-brand-jade hidden" data-feedback="macete">✓ Macete compartilhado!</span>
          </div>
        </form>
      </div>
      <div class="space-y-3">
    `;

    if (list.length === 0) {
      html += `<p class="text-gray-500 text-sm text-center py-12">Nenhum macete ainda. Seja o primeiro a compartilhar!</p>`;
    }

    list.forEach(m => {
      html += `
        <div class="glass-panel rounded-xl p-4 sm:p-5 border border-white/5 flex items-start gap-4">
          <span class="text-2xl font-extrabold text-white font-zh w-10 text-center shrink-0">${m.character}</span>
          <div class="flex-1 min-w-0">
            <p class="text-sm text-gray-200">“${escapeHtml(m.text)}”</p>
            <div class="flex items-center gap-3 mt-2">
              <span class="text-[10px] text-gray-500">por ${escapeHtml(m.author || 'Anônimo')}</span>
              <span class="text-xs text-gray-400 flex items-center gap-1">👍 ${m.votes}</span>
              ${m.votes >= 5 ? '<span class="text-[9px] px-2 py-0.5 rounded-full bg-brand-gold/10 text-brand-gold border border-brand-gold/20">✨ Destaque</span>' : ''}
            </div>
          </div>
        </div>
      `;
    });

    html += `</div>`;
    container.innerHTML = html;
  }

  function renderComentarioBoard(container) {
    const fetched = seedData.comentarios || [];
    const local = getLocal('falo-chines-comments');
    const all = dedupBy([...fetched, ...local], c => c.text).filter(c => c.approved !== false);
    const sorted = all.sort((a, b) => b.timestamp - a.timestamp);

    let html = `
      <div class="mb-6 glass-panel rounded-xl p-4 sm:p-5 border border-white/5">
        <form class="inline-form" data-form="comentario">
          <h4 class="text-xs font-bold text-white mb-3 uppercase tracking-wider">💬 Deixe seu Comentário</h4>
          <input name="author" type="text" placeholder="Seu nome"
            class="w-full mb-2 px-4 py-2 rounded-xl bg-white/5 border border-white/10 text-white text-sm placeholder-gray-500 focus:outline-none focus:border-brand-gold/50 transition-colors" />
          <textarea name="text" rows="2" placeholder="Escreva seu comentário..." required
            class="w-full mb-2 px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white text-sm placeholder-gray-500 focus:outline-none focus:border-brand-gold/50 transition-colors resize-none"></textarea>
          <div class="flex items-center justify-between">
            <button type="submit" class="text-xs font-bold uppercase tracking-wider px-4 py-2 rounded-xl bg-brand-gold/20 text-brand-gold hover:bg-brand-gold/30 border border-brand-gold/30 transition-all">Enviar</button>
            <span class="form-feedback text-[11px] text-brand-jade hidden" data-feedback="comentario">✓ Comentário salvo!</span>
          </div>
        </form>
      </div>
      <div class="space-y-3">
    `;

    if (sorted.length === 0) {
      html += `<p class="text-gray-500 text-sm text-center py-12">Nenhum comentário ainda. Seja o primeiro!</p>`;
    }

    sorted.forEach(c => {
      const targetLink = c.postSlug
        ? `<a href="/blog/${escapeHtml(c.postSlug)}" class="text-[9px] text-brand-blue hover:text-brand-gold transition-colors">📝 ${escapeHtml(c.postSlug)}</a>`
        : c.lessonSlug
        ? `<a href="/licoes/${escapeHtml(c.lessonSlug)}" class="text-[9px] text-brand-blue hover:text-brand-gold transition-colors">📖 ${escapeHtml(c.lessonSlug)}</a>`
        : '';
      html += `
        <div class="glass-panel rounded-xl p-4 sm:p-5 border border-white/5">
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-full bg-brand-gold/20 text-brand-gold flex items-center justify-center text-sm font-bold shrink-0">
              ${escapeHtml(c.author.charAt(0).toUpperCase())}
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-1">
                <span class="text-xs font-bold text-white">${escapeHtml(c.author)}</span>
                <span class="text-[9px] text-gray-500">${new Date(c.timestamp).toLocaleDateString('pt-BR')}</span>
                ${targetLink ? `<span class="text-[9px]">${targetLink}</span>` : ''}
              </div>
              <p class="text-sm text-gray-300">“${escapeHtml(c.text)}”</p>
              ${c.approved === undefined ? '<span class="text-[9px] text-yellow-400 mt-1 block">⏳ Aguardando moderação</span>' : ''}
            </div>
          </div>
        </div>
      `;
    });

    html += `</div>`;
    container.innerHTML = html;
  }

  function escapeHtml(str) {
    const div = document.createElement('div');
    div.appendChild(document.createTextNode(str));
    return div.innerHTML;
  }

  mountBoards();

  // Inline form submission via event delegation
  document.getElementById('comunidade-content').addEventListener('submit', function(e) {
    const form = e.target.closest('form[data-form]');
    if (!form) return;
    e.preventDefault();

    const formType = form.dataset.form;

    if (formType === 'situacao') {
      const title = form.querySelector('[name="title"]').value.trim();
      const description = form.querySelector('[name="description"]').value.trim();
      const tagsStr = form.querySelector('[name="tags"]').value.trim();
      if (!title || !description) return;
      const tags = tagsStr ? tagsStr.split(',').map(function(t) { return t.trim(); }).filter(Boolean) : [];
      const list = getLocal('falo-chines-situations');
      list.push({ id: uid(), title: title, description: description, tags: tags, votes: 1, status: 'pendente', author: 'Anônimo', lessonSlug: '', timestamp: Date.now() });
      setLocal('falo-chines-situations', list);
      showFeedback(form, 'situacao');
      renderSituacaoBoard(panels.situacoes);
    } else if (formType === 'macete') {
      const character = form.querySelector('[name="character"]').value.trim();
      const text = form.querySelector('[name="text"]').value.trim();
      const author = form.querySelector('[name="author"]').value.trim() || 'Anônimo';
      if (!character || !text) return;
      const list = getLocal('falo-chines-mnemonics');
      list.push({ id: uid(), character: character, text: text, author: author, votes: 0, timestamp: Date.now() });
      setLocal('falo-chines-mnemonics', list);
      showFeedback(form, 'macete');
      renderMaceteBoard(panels.macetes);
    } else if (formType === 'comentario') {
      const author = form.querySelector('[name="author"]').value.trim() || 'Anônimo';
      const text = form.querySelector('[name="text"]').value.trim();
      if (!text) return;
      const list = getLocal('falo-chines-comments');
      list.push({ id: uid(), postSlug: '', lessonSlug: '', author: author, text: text, approved: false, timestamp: Date.now() });
      setLocal('falo-chines-comments', list);
      showFeedback(form, 'comentario');
      renderComentarioBoard(panels.comentarios);
    }
  });

  function showFeedback(form, type) {
    var fb = form.querySelector('.form-feedback[data-feedback="' + type + '"]');
    if (fb) {
      fb.classList.remove('hidden');
      setTimeout(function() { fb.classList.add('hidden'); }, 2000);
    }
  }
</script>
